# Copy to .env beside docker/compose.yaml and fill in. Never commit the result.
#
#     cp .env.example .env
#
# Compose refuses to start without POSTGRES_PASSWORD rather than defaulting to
# something guessable — a development password that reaches production is a
# production password that everyone knows.

POSTGRES_DB=jiranisokotech
POSTGRES_USER=jiranisokotech
POSTGRES_PASSWORD=

# The delivery system will answer here. The public website is a separate
# application on its own host.
ERP_DOMAIN=erp.jiranisokotech.co.ke

# The port on the host that the container is published to, bound to localhost.
# Only worth changing if something else has 8080 -- on Windows, note that parts
# of the range are reserved by the operating system and cannot be bound at all.
WEB_PORT=8080

# The network the reverse proxy connects from, as a CIDR range, and the only
# network whose X-Forwarded-For header is believed.
#
# Left blank the application reads the address of whatever connected to it,
# which behind a proxy is the proxy: every sign-in recorded from one address,
# and the careers rate limit sharing a single bucket across the whole internet.
# It is blank by default anyway, because the alternative -- trusting the header
# from anywhere -- lets anyone who can reach the container claim any address
# they like, which is worse than counting wrong.
PROXY_NETWORK=

# The first account, created once on an empty database and ignored afterwards.
# Twelve characters minimum, and no composition rules: length is what costs an
# attacker anything, and a symbol requirement only produces Password1! on every
# account in the building.
#
# Sign in, change this password, then clear these three lines. The seeder never
# touches an account that already exists, so a stale value here cannot re-key
# the owner on the next deploy -- but a password sitting in a file on the host
# is still a password sitting in a file on the host.
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME=

# Mail. The default is File, which writes each message to disk and sends
# nothing -- so a copy of production started by mistake does not email real
# people. Set it to Smtp deliberately, when you mean it.
#
#   File  write to ./mail and send nothing
#   None  discard everything
#   Smtp  actually send
MAIL_TRANSPORT=File
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=delivery@jiranisokotech.co.ke
MAIL_FROM_NAME=Jiranisoko Tech Solutions

# Where the application answers. Messages sent by the background dispatcher have
# no request to read this from, so a link is only as good as this setting.
MAIL_BASE_ADDRESS=https://erp.jiranisokotech.co.ke
