# Copy to .env beside docker/compose.yaml and fill in. Never commit the result.
#
#     cp .env.example .env
#
# Compose refuses to start without POSTGRES_PASSWORD rather than defaulting to
# something guessable — a development password that reaches production is a
# production password that everyone knows.

POSTGRES_DB=jiranisokotech
POSTGRES_USER=jiranisokotech
POSTGRES_PASSWORD=

# The delivery system will answer here. The public website is a separate
# application on its own host.
ERP_DOMAIN=erp.jiranisokotech.co.ke

# The first account, created once on an empty database and ignored afterwards.
# Twelve characters minimum, and no composition rules: length is what costs an
# attacker anything, and a symbol requirement only produces Password1! on every
# account in the building.
#
# Sign in, change this password, then clear these three lines. The seeder never
# touches an account that already exists, so a stale value here cannot re-key
# the owner on the next deploy -- but a password sitting in a file on the host
# is still a password sitting in a file on the host.
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME=
