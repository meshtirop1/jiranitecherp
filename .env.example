# Copy to .env beside docker/compose.yaml and fill in. Never commit the result.
#
#     cp .env.example .env
#
# Compose refuses to start without POSTGRES_PASSWORD rather than defaulting to
# something guessable — a development password that reaches production is a
# production password that everyone knows.

# Which copy of the application this host runs: Production, Staging, Testing or
# Development. Anything but Production puts a banner on every page saying so, so
# that nobody approves a real person's leave on the staging copy by mistake.
APP_ENVIRONMENT=Production

POSTGRES_DB=jiranisokotech
POSTGRES_USER=jiranisokotech
POSTGRES_PASSWORD=

# The delivery system will answer here. The public website is a separate
# application on its own host.
ERP_DOMAIN=erp.jiranisokotech.co.ke

# Where Let's Encrypt writes about the certificate, when the bundled proxy is used
# (docker compose --profile proxy). Blank means delivery@jiranisokotech.co.ke.
ACME_EMAIL=

# The address range of the containers' own network. Only worth changing if it
# collides with a network this host already has.
APP_SUBNET=172.30.80.0/24

# The port on the host that the container is published to, bound to localhost.
# Only worth changing if something else has 8080 -- on Windows, note that parts
# of the range are reserved by the operating system and cannot be bound at all.
WEB_PORT=8080

# The network the reverse proxy connects from, as a CIDR range, and the only
# network whose X-Forwarded-For header is believed.
#
# Left blank the application reads the address of whatever connected to it,
# which behind a proxy is the proxy: every sign-in recorded from one address,
# and the careers rate limit sharing a single bucket across the whole internet.
# It is blank by default anyway, because the alternative -- trusting the header
# from anywhere -- lets anyone who can reach the container claim any address
# they like, which is worse than counting wrong.
#
# With the bundled proxy (--profile proxy), set this to APP_SUBNET: the proxy is a
# container on that network.
PROXY_NETWORK=

# The first account, created once on an empty database and ignored afterwards.
# Twelve characters minimum, and no composition rules: length is what costs an
# attacker anything, and a symbol requirement only produces Password1! on every
# account in the building.
#
# Sign in, change this password, then clear these three lines. The seeder never
# touches an account that already exists, so a stale value here cannot re-key
# the owner on the next deploy -- but a password sitting in a file on the host
# is still a password sitting in a file on the host.
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME=

# Mail. The default is File, which writes each message to disk and sends
# nothing -- so a copy of production started by mistake does not email real
# people. Set it to Smtp deliberately, when you mean it.
#
#   File  write to ./mail and send nothing
#   None  discard everything
#   Smtp  actually send
MAIL_TRANSPORT=File
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=delivery@jiranisokotech.co.ke
MAIL_FROM_NAME=Jiranisoko Tech Solutions

# Where the application answers. Messages sent by the background dispatcher have
# no request to read this from, so a link is only as good as this setting.
MAIL_BASE_ADDRESS=https://erp.jiranisokotech.co.ke

# Attachments, CVs and the key ring that signs cookies are written to volumes
# inside the container rather than to the container itself. Nothing to set here
# -- it is listed so that whoever backs this host up knows there are three
# volumes holding things that cannot be regenerated: jiranisokotech_documents,
# jiranisokotech_cvs and jiranisokotech_keys, alongside jiranisokotech_db-data.
# The backup service below reads all four.

# --- backups -----------------------------------------------------------------
# Where `docker compose run --rm backup` writes, as directories on this host. See
# docs/backups.md for scheduling it and copying the result off the host.
#
# Two directories, and they must not be the same one or one inside the other: the
# key ring decrypts every second factor and webhook secret in the database, so a
# copy holding both undoes the encryption. The backup refuses to run if they are.
# Copy each offsite to a different place, for the same reason.
BACKUP_DIRECTORY=/var/backups/jiranisokotech/data
KEYS_BACKUP_DIRECTORY=/var/backups/jiranisokotech-keys

# Backups older than this many days are removed after each successful backup --
# never after a failed one. 0 keeps everything.
BACKUP_RETENTION_DAYS=30

# --- the code repositories ---------------------------------------------------
# The webhook secret, shared with GitHub. Generate it, put the same value in the
# repository's webhook settings, and connect the repository on /repositories —
# which refuses a secret that does not match this one, because a repository
# connected with the wrong secret is connected and permanently deaf.
#
#   openssl rand -hex 32
#
# Left blank, deliveries are answered with 503 rather than accepted: an endpoint
# with no secret cannot check a signature, and one that accepts whatever it is
# sent would let a stranger write into the firm's record of what was built.
GITHUB_WEBHOOK_SECRET=

# The same for the other hosts, each set in that host's webhook settings. GitLab
# sends it as a token header rather than signing with it; Bitbucket and Azure
# DevOps sign or authenticate with it as their own documentation describes. Leave
# blank any host the firm does not use.
GITLAB_WEBHOOK_SECRET=
BITBUCKET_WEBHOOK_SECRET=
AZURE_DEVOPS_WEBHOOK_SECRET=

# --- the cache ---------------------------------------------------------------
# Where Redis answers. The default is the cache service in compose.yaml, so this
# only needs setting to point at a Redis elsewhere, or to blank to run without
# one: the application then computes every answer instead of caching it, which is
# slower and otherwise identical.
CACHE_CONNECTION=cache:6379

# --- how long things are kept -------------------------------------------------
# Application logs, which Docker keeps rather than the database: each container's
# log is rotated at LOG_MAX_SIZE and LOG_MAX_FILES of them are kept, so the default
# holds about 200 MB per container before the oldest lines go. Everything else --
# applicants, leavers' documents, withdrawn accounts, the audit trail -- is set by
# an administrator on the settings page, and is kept for ever until somebody does.
LOG_MAX_SIZE=20m
LOG_MAX_FILES=10

# --- watching the machinery --------------------------------------------------
# The token a metrics collector presents at /metrics, as a bearer header or a
# ?token= query string.
#
#   openssl rand -hex 32
#
# Left blank, the endpoint is not mounted. That is deliberate: counters look
# harmless and are not — they say how many people sign in, how many invoices go
# out, and when nobody is watching.
METRICS_TOKEN=
