<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A database worth looking at, and not part of the running system.

    In the solution for the same reason the measurement harness is: a tool kept outside it
    stops compiling the first time an interface it calls changes, silently, and is then
    found broken on the afternoon somebody needs it. This one calls almost every
    application service there is, so it is also the widest compile-time check in the
    repository that those services still fit together.

    Nothing publishes it into the runtime image — only src/JiranisokoTech.Web is published —
    which is what keeps a tool that writes rows out of production.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>JiranisokoTech.DemoData</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\JiranisokoTech.Infrastructure\JiranisokoTech.Infrastructure.csproj" />
  </ItemGroup>

</Project>
