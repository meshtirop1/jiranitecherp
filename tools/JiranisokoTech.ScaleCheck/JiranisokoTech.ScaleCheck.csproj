<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A measurement harness, not part of the running system.

    It is in the solution deliberately. A tool kept outside it stops compiling the
    first time an interface it calls changes, silently, and is then discovered
    broken on the afternoon somebody needs a measurement — which is the same class
    of fault as a service method with no caller.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>JiranisokoTech.ScaleCheck</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\JiranisokoTech.Infrastructure\JiranisokoTech.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="volume.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
