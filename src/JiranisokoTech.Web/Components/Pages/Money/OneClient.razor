@page "/clients/{Id:guid}"
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using JiranisokoTech.Application.Abstractions
@using JiranisokoTech.Application.Authorization
@using JiranisokoTech.Application.Business
@using JiranisokoTech.Application.Documents
@using JiranisokoTech.Domain.Clients
@using JiranisokoTech.Domain.Contracts
@using JiranisokoTech.Domain.Documents
@using JiranisokoTech.Infrastructure.Business
@using JiranisokoTech.Infrastructure.People
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = PermissionClaim.PolicyPrefix + Permissions.ClientsView)]
@inject BusinessQueries Queries
@inject ClientService Service
@inject ContractService Contracting
@inject DocumentService Files
@inject PeopleQueries People
@inject IClock Clock
@inject NavigationManager Navigation

@*
    Clients were a flat list with no way to open one, which meant the contract
    you could attach to a client had nowhere to be attached from. The list is
    still where you scan; this is where you deal with one of them.
*@

@if (Client is null)
{
    <PageTitle>Client not found — Jiranisoko Delivery</PageTitle>

    <h1>No such client</h1>
    <p>Nothing here has that identifier. <a href="/clients">Back to clients</a>.</p>
}
else
{
    <PageTitle>@Client.Name — Jiranisoko Delivery</PageTitle>

    <nav class="crumbs"><a href="/clients">Clients</a></nav>

    <div class="page-head">
        <h1>@Client.Name</h1>
        <span class="pill @PillFor(Client.Status)">@Words.For(Client.Status)</span>
    </div>

    @if (Refusal is not null)
    {
        <p class="refusal" role="alert">@Refusal</p>
    }

    <dl class="facts">
        <dt>Code</dt>
        <dd><code>@Client.Code</code></dd>

        <dt>Who we deal with</dt>
        <dd>@(Client.ContactName ?? "—")</dd>

        <dt>Their email</dt>
        <dd>@(Client.ContactEmail ?? "—")</dd>

        <dt>Where invoices go</dt>
        <dd>@(Client.InvoiceAddress ?? "Nowhere — no email has been recorded")</dd>

        <dt>Terms</dt>
        <dd>@Client.PaymentTermDays days</dd>
    </dl>

    <AuthorizeView Policy="@ManagePolicy" Context="mayManage">
        <EditForm Model="State" method="post" OnValidSubmit="MoveTo" FormName="status"
                  class="inline">
            <label>
                <span>State</span>
                <InputSelect @bind-Value="State.Status">
                    @foreach (var status in Enum.GetValues<ClientStatus>())
                    {
                        <option value="@status">@Words.For(status)</option>
                    }
                </InputSelect>
            </label>
            <button type="submit" class="button button--quiet">Change it</button>
        </EditForm>
    </AuthorizeView>

    @*
        Contracts before invoices, in the order the firm does them. A contract is
        the authority for a bill and an invoice is the bill, and reading the page
        the other way round is what made it possible to raise one with nothing
        behind it.
    *@
    <AuthorizeView Policy="@ContractsPolicy" Context="maySeeContracts">
        <section class="standing">
            <h2>Contracts</h2>

            @if (Contracts.Count == 0)
            {
                <p class="empty">
                    Nothing has been agreed with this client in writing. An invoice
                    raised now has no contract behind it.
                </p>
            }
            else
            {
                @*
                    Said out loud rather than enforced. Invoicing is deliberately
                    not blocked on a contract — every client here predates
                    contracts existing, and a system that refuses to invoice stops
                    the firm being paid — so the gap is something this page
                    reports instead.
                *@
                @if (!Contracts.Exists(contract => contract.CoversOn(Today)))
                {
                    <p class="subtle">
                        Nothing on this list covers today, so work done now is not
                        under any of them.
                    </p>
                }

                <table class="grid">
                    <caption class="visually-hidden">Contracts with this client</caption>
                    <thead>
                        <tr>
                            <th scope="col">Reference</th>
                            <th scope="col">What it is for</th>
                            <th scope="col">Worth</th>
                            <th scope="col">Runs</th>
                            <th scope="col">State</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var contract in Contracts)
                        {
                            <tr>
                                <td>
                                    <a href="/contracts/@contract.Id"><code>@contract.Reference</code></a>
                                </td>
                                <td>@contract.Title</td>
                                <td class="number">@(contract.Value?.ToString() ?? "—")</td>
                                <td>
                                    @if (contract.StartsOn is { } from && contract.EndsOn is { } to)
                                    {
                                        @($"{from:d MMM yyyy} – {to:d MMM yyyy}")
                                    }
                                    else
                                    {
                                        @("—")
                                    }
                                </td>
                                <td>
                                    <span class="pill @PillFor(contract.State)">@Words.For(contract.State)</span>
                                    @if (contract.HasExpiredOn(Today))
                                    {
                                        <span class="pill pill--quiet">Expired</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            <AuthorizeView Policy="@ContractsManagePolicy" Context="mayAgree">
                <EditForm Model="Drafting" method="post" OnValidSubmit="DraftContract"
                          FormName="contract" class="inline">
                    <DataAnnotationsValidator />
                    <label>
                        <span>Reference</span>
                        <InputText @bind-Value="Drafting.Reference" />
                    </label>
                    <label>
                        <span>What it is for</span>
                        <InputText @bind-Value="Drafting.Title" />
                    </label>
                    <button type="submit" class="button button--quiet">Open a contract</button>
                    <ValidationMessage For="() => Drafting.Reference" />
                    <ValidationMessage For="() => Drafting.Title" />
                </EditForm>
            </AuthorizeView>
        </section>
    </AuthorizeView>

    <section class="standing">
        <h2>Invoices</h2>

        @if (Invoices.Count == 0)
        {
            <p class="empty">Nothing has been invoiced to this client.</p>
        }
        else
        {
            <table class="grid">
                <caption class="visually-hidden">Invoices for this client</caption>
                <thead>
                    <tr>
                        <th scope="col">Number</th>
                        <th scope="col">Issued</th>
                        <th scope="col">Total</th>
                        <th scope="col">Outstanding</th>
                        <th scope="col">State</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var invoice in Invoices)
                    {
                        <tr>
                            <td><a href="/invoices/@invoice.Id"><code>@invoice.Number</code></a></td>
                            <td>@invoice.IssuedOn.ToString("d MMM yyyy")</td>
                            <td class="number">@invoice.Total</td>
                            <td class="number">@invoice.Outstanding</td>
                            <td>@Words.For(invoice.Status)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <section class="standing">
        <h2>Attached</h2>

        @if (Attached.Count == 0)
        {
            <p class="empty">Nothing attached. Contracts and signed orders belong here.</p>
        }
        else
        {
            <ul class="plain">
                @foreach (var file in Attached)
                {
                    <li>
                        <a href="/documents/@file.Id">@file.FileName</a>
                        <span class="subtle">
                            @file.Size, @file.UploadedAt.ToString("d MMM yyyy")@(file.Note is { } note ? $" — {note}" : null)
                        </span>

                        <AuthorizeView Policy="@ManagePolicy" Context="mayRemove">
                            @*
                                Removing takes the file with the row. There is no
                                confirmation step here and that is deliberate: the
                                act is on the audit trail with a name against it,
                                and a dialog that everybody clicks through is
                                ceremony rather than a safeguard.
                            *@
                            <form method="post" @formname="@($"detach-{file.Id}")"
                                  @onsubmit="() => Detach(file.Id)">
                                <AntiforgeryToken />
                                <button type="submit" class="danger">Remove</button>
                            </form>
                        </AuthorizeView>
                    </li>
                }
            </ul>
        }

        <AuthorizeView Policy="@ManagePolicy" Context="mayAttach">
            <EditForm Model="Attaching" method="post" OnValidSubmit="Attach" FormName="attach"
                      enctype="multipart/form-data" class="inline">
                <label>
                    <span class="visually-hidden">A file</span>
                    <input type="file" name="document" />
                </label>
                <InputText @bind-Value="Attaching.Note" placeholder="What it is" />
                <button type="submit" class="button button--quiet">Attach</button>
            </EditForm>
        </AuthorizeView>
    </section>
}

@code {
    private const string ManagePolicy = PermissionClaim.PolicyPrefix + Permissions.ClientsManage;

    private const string ContractsPolicy = PermissionClaim.PolicyPrefix + Permissions.ContractsView;

    private const string ContractsManagePolicy =
        PermissionClaim.PolicyPrefix + Permissions.ContractsManage;

    [Parameter]
    public Guid Id { get; set; }

    [CascadingParameter]
    private HttpContext? Request { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    private StatusInput _state = new();

    [SupplyParameterFromForm(FormName = "status")]
    private StatusInput State
    {
        get => _state;
        set => _state = value ?? new StatusInput();
    }

    private AttachInput _attaching = new();

    [SupplyParameterFromForm(FormName = "attach")]
    private AttachInput Attaching
    {
        get => _attaching;
        set => _attaching = value ?? new AttachInput();
    }

    private ContractInput _drafting = new();

    [SupplyParameterFromForm(FormName = "contract")]
    private ContractInput Drafting
    {
        get => _drafting;
        set => _drafting = value ?? new ContractInput();
    }

    private Client? Client { get; set; }

    private Guid? Me { get; set; }

    private DateOnly Today { get; set; }

    private List<ContractRow> Contracts { get; set; } = [];

    private List<InvoiceRow> Invoices { get; set; } = [];

    private List<Attachment> Attached { get; set; } = [];

    private string? Refusal { get; set; }

    private bool _loaded;

    protected override async Task OnInitializedAsync()
    {
        Today = Clock.Today;

        var state = await AuthenticationState;

        if (Guid.TryParse(state.User.FindFirstValue(ClaimTypes.NameIdentifier), out var account))
        {
            Me = await People.EmployeeForAccountAsync(account);
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        Client = await Queries.ClientAsync(Id);

        if (Client is null)
        {
            return;
        }

        Contracts = await Queries.ContractsAsync(clientId: Id);
        Invoices = await Queries.InvoicesAsync(clientId: Id);
        Attached = await Files.ForAsync(AttachedTo.Client, Id);

        // Only before the form has been posted, or a refused change would show
        // the stored value rather than the one somebody chose.
        if (!_loaded)
        {
            State.Status = Client.Status;
            _loaded = true;
        }
    }

    private Task MoveTo() => TryAsync(() => Service.MoveToAsync(Id, State.Status));

    /// <summary>
    /// Open a contract and go straight to it.
    /// </summary>
    /// <remarks>
    /// Not back to this page, unlike every other form here. What was just created
    /// is empty — no figure, no dates — and leaving somebody on the client page
    /// to find it in a list is how a draft with nothing in it stays that way.
    /// </remarks>
    private async Task DraftContract()
    {
        Refusal = null;

        try
        {
            var contract = await Contracting.DraftAsync(Id, Drafting.Reference, Drafting.Title);
            Navigation.NavigateTo($"/contracts/{contract.Id}", forceLoad: true);
        }
        catch (Exception exception) when (
            exception is InvalidOperationException or ArgumentException)
        {
            Refusal = exception.Message;
            await LoadAsync();
        }
    }

    private Task Detach(Guid file) => TryAsync(() => Files.RemoveAsync(file));

    private Task Attach() => TryAsync(async () =>
    {
        var file = Request?.Request.Form.Files["document"];

        if (file is not { Length: > 0 })
        {
            throw new InvalidOperationException("Choose a file first.");
        }

        await using var contents = file.OpenReadStream();

        await Files.AttachAsync(
            AttachedTo.Client, Id, contents, file.FileName, file.Length, Me, Attaching.Note);
    });

    private async Task TryAsync(Func<Task> act)
    {
        Refusal = null;

        try
        {
            await act();
            Navigation.NavigateTo($"/clients/{Id}", forceLoad: true);
        }
        catch (Exception exception) when (
            exception is InvalidOperationException or ArgumentException)
        {
            Refusal = exception.Message;
            await LoadAsync();
        }
    }

    private static string? PillFor(ClientStatus status) => status switch
    {
        ClientStatus.Active => "pill--done",
        ClientStatus.Former => "pill--quiet",
        _ => null,
    };

    private static string? PillFor(ContractState state) => state switch
    {
        ContractState.Active => "pill--done",
        ContractState.Terminated => "pill--quiet",
        _ => null,
    };

    private sealed class StatusInput
    {
        public ClientStatus Status { get; set; } = ClientStatus.Prospect;
    }

    private sealed class ContractInput
    {
        [Required(ErrorMessage = "A reference. It is what both sides quote at each other.")]
        [StringLength(60)]
        public string Reference { get; set; } = string.Empty;

        [Required(ErrorMessage = "Say what the agreement is for.")]
        [StringLength(300)]
        public string Title { get; set; } = string.Empty;
    }

    private sealed class AttachInput
    {
        [StringLength(500)]
        public string? Note { get; set; }
    }
}
