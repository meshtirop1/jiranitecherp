@page "/hiring/postings"
@using System.ComponentModel.DataAnnotations
@using JiranisokoTech.Application.Abstractions
@using JiranisokoTech.Application.Authorization
@using JiranisokoTech.Application.Recruitment
@using JiranisokoTech.Domain.Recruitment
@using JiranisokoTech.Infrastructure.Recruitment
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = PermissionClaim.PolicyPrefix + Permissions.PostingsManage)]
@inject RecruitmentQueries Queries
@inject RecruitmentService Service
@inject IClock Clock
@inject NavigationManager Navigation

@*
    The advert, which is the link the hiring chain was missing.

    Everything on either side of this page already existed: a requisition could
    be raised and approved, applications could be read, interviews scheduled and
    scored, and the careers site was built to list adverts and take applications
    against them. Nothing could create the advert. So an approved requisition
    could never become a job anybody could apply to, the careers page could only
    ever be empty, and the applications screen had nothing to show — four
    working modules with no way to reach each other.
*@

<PageTitle>Adverts — Jiranisoko Delivery</PageTitle>

<nav class="crumbs"><a href="/hiring">Hiring</a></nav>

<div class="page-head">
    <h1>Adverts</h1>
    <p class="subtle">@Rows.Count(row => row.Status == PostingStatus.Published) live.</p>
</div>

@if (Refusal is not null)
{
    <p class="refusal" role="alert">@Refusal</p>
}

@if (Approved.Count == 0)
{
    @*
        Said rather than showing an empty form. An advert hangs off an approved
        requisition — the domain refuses to publish one that does not — so the
        thing to do about having none is to go and get one approved.
    *@
    <p class="empty">
        No requisition has been approved, and an advert can only be written
        against one. <a href="/hiring">Raise one</a> first.
    </p>
}
else
{
    <EditForm Model="Input" method="post" OnValidSubmit="Draft" FormName="draft"
              class="panel stack">
        <DataAnnotationsValidator />

        <h2>Write an advert</h2>

        <label>
            <span>Against which requisition</span>
            <InputSelect @bind-Value="Input.RequisitionId">
                @foreach (var requisition in Approved)
                {
                    <option value="@requisition.Id">
                        @requisition.JobTitle — @requisition.Remaining still to fill
                    </option>
                }
            </InputSelect>
            <ValidationMessage For="() => Input.RequisitionId" />
        </label>

        <label>
            <span>Title</span>
            <InputText @bind-Value="Input.Title" />
            <ValidationMessage For="() => Input.Title" />
        </label>

        <label>
            <span>The short version</span>
            @*
                What appears on the careers list. Separate from the description
                because the list is scanned and the advert is read, and one
                paragraph doing both jobs does neither.
            *@
            <InputText @bind-Value="Input.Summary" />
            <ValidationMessage For="() => Input.Summary" />
        </label>

        <label>
            <span>The advert itself</span>
            <InputTextArea @bind-Value="Input.Description" rows="8"
                           placeholder="What the job is, what it needs, what it is like to do it." />
            <ValidationMessage For="() => Input.Description" />
        </label>

        <div class="fields">
            <label>
                <span>Where</span>
                <InputText @bind-Value="Input.Location" placeholder="Nairobi, or remote" />
            </label>

            <label>
                <span>Web address</span>
                @*
                    Offered rather than generated silently: it goes in the link
                    the firm sends out, and somebody will want to choose it.
                *@
                <InputText @bind-Value="Input.Slug" placeholder="From the title" />
            </label>
        </div>

        <p class="subtle">
            Writing it does not publish it. Nothing is public until you say so.
        </p>

        <button type="submit">Write it</button>
    </EditForm>
}

@if (Rows.Count == 0)
{
    <p class="empty">Nothing has been advertised.</p>
}
else
{
    <table class="grid">
        <caption class="visually-hidden">Adverts</caption>
        <thead>
            <tr>
                <th scope="col">Title</th>
                <th scope="col">Where</th>
                <th scope="col">Applications</th>
                <th scope="col">State</th>
                <th scope="col"><span class="visually-hidden">Actions</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Rows)
            {
                <tr>
                    <td>
                        @if (row.Status == PostingStatus.Published)
                        {
                            <a href="/careers/@row.Slug">@row.Title</a>
                        }
                        else
                        {
                            @row.Title
                        }
                    </td>
                    <td>@(row.Location ?? "—")</td>
                    <td class="number">
                        @if (row.Applications > 0)
                        {
                            <a href="/hiring/applications?posting=@row.Id">@row.Applications</a>
                        }
                        else
                        {
                            @("0")
                        }
                    </td>
                    <td>
                        <span class="pill @PillFor(row.Status)">@row.Status</span>
                        @if (row.PublishedAt is { } published)
                        {
                            <span class="subtle">since @published.ToString("d MMM yyyy")</span>
                        }
                    </td>
                    <td class="actions">
                        @if (row.Status == PostingStatus.Draft)
                        {
                            <form method="post" @formname="@($"publish-{row.Id}")"
                                  @onsubmit="() => Publish(row.Id)">
                                <AntiforgeryToken />
                                <button type="submit">Publish it</button>
                            </form>
                        }
                        else if (row.Status == PostingStatus.Published)
                        {
                            @*
                                Closing stops new applications and leaves the ones
                                already in. An advert taken down is not a hiring
                                round abandoned.
                            *@
                            <form method="post" @formname="@($"close-{row.Id}")"
                                  @onsubmit="() => Close(row.Id)">
                                <AntiforgeryToken />
                                <button type="submit" class="button button--quiet">Take it down</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private DraftInput _input = new();

    [SupplyParameterFromForm(FormName = "draft")]
    private DraftInput Input
    {
        get => _input;
        set => _input = value ?? new DraftInput();
    }

    private List<PostingRow> Rows { get; set; } = [];

    private List<RequisitionRow> Approved { get; set; } = [];

    private string? Refusal { get; set; }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        Rows = await Queries.PostingsAsync();

        var all = await Queries.RequisitionsAsync();

        // Approved, and with somebody still to hire against it. Advertising a
        // requisition that is already filled is how a firm ends up interviewing
        // for a post it cannot offer.
        Approved = [.. all.Where(one =>
            one.Status == RequisitionStatus.Approved && one.Remaining > 0)];

        Input.RequisitionId ??= Approved.FirstOrDefault()?.Id;
    }

    private Task Draft() => TryAsync(() => Service.DraftPostingAsync(
        Input.RequisitionId!.Value,
        Input.Title,
        Input.Summary,
        Input.Description,
        Input.Location,
        string.IsNullOrWhiteSpace(Input.Slug) ? null : Input.Slug));

    private Task Publish(Guid id) => TryAsync(() => Service.PublishAsync(id));

    private Task Close(Guid id) => TryAsync(() => Service.ClosePostingAsync(id));

    private async Task TryAsync(Func<Task> act)
    {
        Refusal = null;

        try
        {
            await act();
            Navigation.NavigateTo("/hiring/postings", forceLoad: true);
        }
        catch (Exception exception) when (
            exception is InvalidOperationException or ArgumentException)
        {
            Refusal = exception.Message;
            await LoadAsync();
        }
    }

    private static string? PillFor(PostingStatus status) => status switch
    {
        PostingStatus.Published => "pill--done",
        PostingStatus.Closed => "pill--quiet",
        _ => null,
    };

    private sealed class DraftInput
    {
        [Required(ErrorMessage = "Choose the requisition this is for.")]
        public Guid? RequisitionId { get; set; }

        [Required(ErrorMessage = "An advert needs a title.")]
        [StringLength(200)]
        public string Title { get; set; } = string.Empty;

        [Required(ErrorMessage = "One line for the careers list.")]
        [StringLength(500)]
        public string Summary { get; set; } = string.Empty;

        [Required(ErrorMessage = "Say what the job is.")]
        [StringLength(20000)]
        public string Description { get; set; } = string.Empty;

        [StringLength(200)]
        public string? Location { get; set; }

        [StringLength(120)]
        public string? Slug { get; set; }
    }
}
