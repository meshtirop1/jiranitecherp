@page "/settings/machinery"
@using System.Security.Claims
@using JiranisokoTech.Application.Authorization
@using JiranisokoTech.Domain.Engineering
@using JiranisokoTech.Infrastructure.Engineering
@using JiranisokoTech.Infrastructure.Scheduling
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = PermissionClaim.PolicyPrefix + Permissions.SettingsManage)]
@inject JobQueries Jobs
@inject HostHealthQueries Hosts
@inject JobRunner Runner
@inject NavigationManager Navigation

<PageTitle>Machinery — Jiranisoko Delivery</PageTitle>

<nav class="crumbs"><a href="/settings">Settings</a></nav>

<div class="page-head">
    <h1>Machinery</h1>
</div>

<p class="instructions">
    The parts of this system that run without anybody asking: three queues and the
    scheduled jobs. Brought together on one screen because the question somebody asks
    is "is anything stuck", not "is the outbox stuck".
</p>

@if (Refusal is not null)
{
    <p class="refusal" role="alert">@Refusal</p>
}

@if (Shut.Count > 0)
{
    @*
        Above the queue depths on purpose. Those are all zero when this is wrong, so a
        reader who scanned down the page would conclude everything was fine — and the
        reason it is wrong is that nothing is arriving to be counted.
    *@
    <p class="refusal" role="alert">
        <strong>@string.Join(", ", Shut.Select(host => Said(host.Provider)))</strong>
        @(Shut.Count == 1 ? "has" : "have") repositories connected and
        @(Shut.Count == 1 ? "cannot" : "cannot") deliver anything here. Every push is being
        refused before it is written down, so the queues below will read zero however long
        this lasts.
    </p>
}

@if (Depths is { AnythingNeedsSomebody: true })
{
    @*
        Waiting and given-up are kept apart everywhere, because they want opposite
        responses: something waiting will sort itself out, and something given up on
        never will until a person does something.
    *@
    <p class="refusal" role="alert">
        <strong>@Depths.TotalAbandoned</strong>
        @(Depths.TotalAbandoned == 1 ? "thing has" : "things have") given up and will not
        be tried again without somebody.
    </p>
}

<section class="standing">
    <h2>Queues</h2>

    @if (Depths is null)
    {
        <p class="empty">Nothing to report.</p>
    }
    else
    {
        <table class="grid">
            <caption class="visually-hidden">Queue depths</caption>
            <thead>
                <tr>
                    <th scope="col">Queue</th>
                    <th scope="col">Waiting</th>
                    <th scope="col">Gave up</th>
                    <th scope="col"></th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>
                        <strong>Events</strong>
                        <span class="subtle">
                            This system's own handlers, after a change is saved
                        </span>
                    </td>
                    <td class="number">@Depths.OutboxWaiting</td>
                    <td class="number @(Depths.OutboxAbandoned > 0 ? "over" : null)">
                        @Depths.OutboxAbandoned
                    </td>
                    <td><a href="/settings/events">Look</a></td>
                </tr>
                <tr>
                    <td>
                        <strong>Deliveries in</strong>
                        <span class="subtle">What the Git hosts have sent</span>
                    </td>
                    <td class="number">@Depths.DeliveriesWaiting</td>
                    <td class="number @(Depths.DeliveriesDeadLettered > 0 ? "over" : null)">
                        @Depths.DeliveriesDeadLettered
                    </td>
                    <td><a href="/repositories/deliveries">Look</a></td>
                </tr>
                <tr>
                    <td>
                        <strong>Notifications out</strong>
                        <span class="subtle">What this system is telling other systems</span>
                    </td>
                    <td class="number">@Depths.NotificationsWaiting</td>
                    <td class="number @(Depths.NotificationsDeadLettered > 0 ? "over" : null)">
                        @Depths.NotificationsDeadLettered
                    </td>
                    <td><a href="/settings/webhooks">Look</a></td>
                </tr>
            </tbody>
        </table>

        <p class="subtle">
            Depths are counted in the database each time this page opens, never tracked
            in memory — a counter would drift the first time a process restarted
            mid-batch, and a wrong depth here is worse than none because somebody acts
            on it.
        </p>
    }
</section>

<section class="standing">
    <h2>Code hosts</h2>

    @if (Hosting.Count == 0)
    {
        <p class="empty">No code host is set up.</p>
    }
    else
    {
        <table class="grid">
            <caption class="visually-hidden">Code hosts</caption>
            <thead>
                <tr>
                    <th scope="col">Host</th>
                    <th scope="col">Watching</th>
                    <th scope="col">Can it get in</th>
                    <th scope="col">Last heard</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var host in Hosting)
                {
                    <tr>
                        <td><strong>@Said(host.Provider)</strong></td>
                        <td class="number">@host.Connected</td>
                        <td>
                            @if (!host.CanBeRead)
                            {
                                <span class="pill pill--danger">Nothing reads it</span>
                            }
                            else if (!host.SecretConfigured)
                            {
                                @*
                                    Whether, never the value and never part of it. This
                                    screen is one somebody leaves open on a second monitor.
                                *@
                                <span class="pill pill--danger">No secret configured</span>
                            }
                            else
                            {
                                <span class="pill pill--done">Yes</span>
                            }
                        </td>
                        <td>
                            @if (host.LastHeardAt is { } at)
                            {
                                @at.ToString("d MMM HH:mm")

                                @if (host.QuietTooLong)
                                {
                                    @*
                                        Amber, not red. A fortnight of quiet on a repository
                                        nobody pushed to is not a fault — but a secret that
                                        is present and wrong looks exactly like this, and
                                        nothing else in the system can tell the two apart.
                                    *@
                                    <span class="pill pill--wait">Quiet a while</span>
                                }
                            }
                            else if (host.NeverHeardFrom)
                            {
                                @*
                                    A prompt rather than a verdict. Most hosts send a test
                                    delivery when a webhook is added, so its absence usually
                                    means the webhook was never added — but a host set up two
                                    minutes ago looks identical.
                                *@
                                <span class="pill pill--wait">Never</span>
                            }
                            else
                            {
                                <span class="subtle">—</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <p class="subtle">
            This table reports the configuration and not a count, because a host that cannot
            be read from writes nothing to count. A refusal at the door happens before a
            delivery row exists — so the queues above stay at zero for as long as it lasts,
            and they are the only other place anybody would look.
        </p>

        <p class="subtle">
            A secret that is configured and <em>wrong</em> — rotated on the host, or
            truncated by a copy and paste — cannot be told from a correct one here: it is
            present and non-empty, and the delivery it refuses is refused at the signature,
            which also writes nothing. The only sign is silence, which is why a host set up
            properly and quiet for
            @($"{HostHealthQueries.LongEnoughToAsk.TotalDays:0}") days is marked rather than
            left alone. It may simply mean nobody pushed anything.
        </p>
    }
</section>

<section class="standing">
    <h2>Scheduled jobs</h2>

    @if (States.Count == 0)
    {
        <p class="empty">No jobs are registered.</p>
    }
    else
    {
        <table class="grid">
            <caption class="visually-hidden">Scheduled jobs</caption>
            <thead>
                <tr>
                    <th scope="col">Job</th>
                    <th scope="col">Every</th>
                    <th scope="col">Last ran</th>
                    <th scope="col">What it found</th>
                    <th scope="col"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var job in States)
                {
                    <tr>
                        <td>
                            <code>@job.Name</code>
                            <span class="subtle">@job.Description</span>
                        </td>
                        <td>@Said(job.Every)</td>
                        <td>
                            @if (job.HasNeverRun)
                            {
                                @* Different from late, and only one of them means the
                                   job has stopped. *@
                                <span class="pill pill--quiet">Never</span>
                            }
                            else
                            {
                                @job.LastAt!.Value.ToString("d MMM HH:mm")

                                @if (job.OnlyEverByHand)
                                {
                                    @*
                                        Said in its own words rather than as "Overdue"
                                        beside a run that finished two minutes ago, which
                                        reads as a bug in the screen and gets dismissed.
                                        This is the screen correctly reporting that the
                                        only thing running this job is a person.
                                    *@
                                    <span class="pill pill--danger">Never on its own</span>
                                }
                                else if (job.IsOverdue)
                                {
                                    <span class="pill pill--danger">Overdue</span>
                                }
                                @if (job.LastMilliseconds is { } took)
                                {
                                    <span class="subtle">@took ms</span>
                                }
                            }
                        </td>
                        <td>
                            @if (job.LastFailed)
                            {
                                <span class="pill pill--danger">Failed</span>
                            }
                            <span class="subtle">@(job.LastDetail ?? "—")</span>

                            @if (job.LastWasByHand)
                            {
                                <span class="subtle">asked for by @job.LastAskedBy</span>
                            }
                        </td>
                        <td>
                            @*
                                Safe to offer because every job is required to be safe to
                                run twice — IRecurringJob says so, and it has to, since a
                                process dying between the work and the record produces
                                exactly the same thing. What this does not do is move the
                                timetable: the scheduler ignores runs a person asked for.
                            *@
                            <EditForm Model="Nothing" method="post"
                                      FormName="@($"run-{job.Name}")"
                                      OnValidSubmit="() => Run(job.Name)" class="inline">
                                <button type="submit">Run it now</button>
                            </EditForm>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <p class="subtle">
            A job is called overdue after twice its interval, not once. A daily job that
            ran at 09:01 one morning and 09:02 the next is a minute late and not a
            problem; one that has not run in two days has stopped.
        </p>

        <p class="subtle">
            Lateness is measured against the scheduler&rsquo;s own runs and not against
            runs somebody asked for. Otherwise pressing <em>Run it now</em> to check a
            suspect job would clear its badge, so the act of checking would erase the
            evidence — and a dead scheduler would look healthy for as long as anybody kept
            checking.
        </p>
    }
</section>

<section class="standing">
    <h2>Recent runs</h2>

    @if (History.Count == 0)
    {
        <p class="empty">Nothing has run yet.</p>
    }
    else
    {
        <table class="grid">
            <caption class="visually-hidden">Recent job runs</caption>
            <thead>
                <tr>
                    <th scope="col">When</th>
                    <th scope="col">Job</th>
                    <th scope="col">Took</th>
                    <th scope="col">What happened</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var run in History)
                {
                    <tr>
                        <td>@run.At.ToString("d MMM HH:mm:ss")</td>
                        <td>
                            <code>@run.Job</code>

                            @if (!run.WasScheduled)
                            {
                                <span class="subtle">@run.AskedBy asked</span>
                            }
                        </td>
                        <td class="number">@run.Milliseconds ms</td>
                        <td>
                            @if (run.Outcome == JobOutcome.Failed)
                            {
                                <span class="pill pill--danger">Failed</span>
                            }
                            <span class="subtle">@run.Detail</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    /// <summary>
    /// A model for the run forms, which submit no fields.
    /// </summary>
    /// <remarks>
    /// This page is statically rendered, so a button outside a form does nothing at all —
    /// and EditForm insists on a model even when the only thing being said is that the
    /// button was pressed.
    /// </remarks>
    private object Nothing { get; } = new();

    private string? Refusal { get; set; }

    private List<JobState> States { get; set; } = [];

    private List<JobRun> History { get; set; } = [];

    private QueueDepths? Depths { get; set; }

    private List<HostHealth> Hosting { get; set; } = [];

    private List<HostHealth> Shut => [.. Hosting.Where(host => host.Shut)];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        States = await Jobs.JobsAsync();
        History = await Jobs.HistoryAsync();
        Depths = await Jobs.DepthsAsync();
        Hosting = await Hosts.HostsAsync();
    }

    /// <summary>
    /// Run one job now, and say who asked.
    /// </summary>
    /// <remarks>
    /// This runs the job inside the request, which is unusual and deliberate. The
    /// alternative — queueing it and telling the reader to come back — would mean the one
    /// thing somebody wants from this button, the answer to "does it work now", arrives
    /// somewhere else. Every job here finishes in milliseconds on this firm's data, and
    /// the run is recorded either way, so a request that times out still leaves the
    /// evidence behind.
    /// </remarks>
    private async Task Run(string name)
    {
        Refusal = null;

        var state = await AuthenticationState;

        var who = state.User.FindFirstValue("display_name")
            ?? state.User.Identity?.Name
            ?? "somebody signed in";

        var run = await Runner.RunAsync(name, who);

        if (run is null)
        {
            /*
             * The job was removed from the code between this page rendering and the button
             * being pressed. Rare, and a five-hundred page for it would be worse than a
             * sentence.
             */
            Refusal = $"No job is registered under the name {name} any more.";
            await LoadAsync();
            return;
        }

        // Reloaded rather than re-rendered, so the history shows the run that just
        // happened instead of the state this request was built from.
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }

    /// <summary>A host's name as its own documentation spells it.</summary>
    private static string Said(GitProvider provider) => provider switch
    {
        GitProvider.AzureDevOps => "Azure DevOps",
        _ => provider.ToString(),
    };

    /// <summary>An interval as somebody would say it.</summary>
    private static string Said(TimeSpan every) => every switch
    {
        { TotalDays: >= 1 } when every.TotalDays % 1 == 0 =>
            every.TotalDays == 1 ? "day" : $"{every.TotalDays:0} days",
        { TotalHours: >= 1 } => every.TotalHours == 1 ? "hour" : $"{every.TotalHours:0} hours",
        _ => $"{every.TotalMinutes:0} minutes",
    };
}
