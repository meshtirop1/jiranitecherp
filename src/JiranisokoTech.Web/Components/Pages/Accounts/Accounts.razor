@page "/accounts"
@using System.ComponentModel.DataAnnotations
@using JiranisokoTech.Application.Authorization
@using JiranisokoTech.Infrastructure.Identity
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = PermissionClaim.PolicyPrefix + Permissions.UsersView)]
@inject UserDirectory Directory
@inject UserAdministration Administration

<PageTitle>Accounts — Jiranisoko Delivery</PageTitle>

<h1>Accounts</h1>

@if (Refusal is not null)
{
    <p class="refusal" role="alert">@Refusal</p>
}

@if (Invited is not null)
{
    @*
        The link is shown whether or not the email went. An administrator who
        has just opened an account is standing next to the person half the time,
        and waiting for an inbox to refresh is a worse experience than reading
        it out.
    *@
    <div class="done" role="status">
        <p><strong>@Invited.Value.Name</strong> now has an account, with no password yet.</p>

        @if (Invited.Value.Sent)
        {
            <p>The link has been emailed to them. It is also here, if you would rather say it in person.</p>
        }
        else
        {
            @* Named rather than hidden. An invitation that silently failed to
               send is somebody waiting for an email that is never coming. *@
            <p>
                <strong>The email did not go.</strong> Send them this link
                yourself, and check how mail is configured.
            </p>
        }

        <p><code class="link">@Invited.Value.Link</code></p>
    </div>
}

<table class="grid">
    <thead>
        <tr>
            <th scope="col">Name</th>
            <th scope="col">Email</th>
            <th scope="col">Roles</th>
            <th scope="col">Staff record</th>
            <th scope="col">State</th>
            <th scope="col">Last seen</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var account in Rows)
        {
            <tr class="@(account.IsActive ? "" : "row--closed")">
                <td><a href="/accounts/@account.Id">@account.DisplayName</a></td>
                <td>@account.Email</td>
                <td>@(account.Roles.Count == 0 ? "None" : string.Join(", ", account.Roles))</td>
                @*
                    Named plainly. An account with no staff record behind it
                    cannot be given work, cannot appear on the organisation
                    chart and cannot be asked to approve anything, and that is
                    invisible everywhere else.
                *@
                <td>@(account.EmployeeName ?? "Not linked")</td>
                <td>@account.State</td>
                <td>@(account.LastSignedInAt?.ToString("d MMM yyyy") ?? "—")</td>
            </tr>
        }
    </tbody>
</table>

<AuthorizeView Policy="@(PermissionClaim.PolicyPrefix + Permissions.UsersInvite)" Context="permitted">
    <h2>Open an account</h2>

    <p class="subtle">
        They set their own password from a link, which is emailed to them.
        Nobody here ever types it for them — an administrator who knows
        somebody else password makes every action by that person deniable.
    </p>

    <EditForm Model="Input" method="post" OnValidSubmit="Invite" FormName="invite" class="stack">
        <DataAnnotationsValidator />

        <label>
            <span>Name</span>
            <InputText @bind-Value="Input.DisplayName" />
            <ValidationMessage For="() => Input.DisplayName" />
        </label>

        <label>
            <span>Email</span>
            <InputText @bind-Value="Input.Email" type="email" />
            <ValidationMessage For="() => Input.Email" />
        </label>

        <label>
            <span>Job title</span>
            <InputText @bind-Value="Input.JobTitle" />
        </label>

        <button type="submit">Open it</button>
    </EditForm>
</AuthorizeView>

@code {
    [CascadingParameter]
    private HttpContext? Request { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    /// <summary>
    /// Who opened the account, named in the message they receive.
    /// </summary>
    /// <remarks>
    /// An invitation from a name somebody recognises is one they act on. An
    /// invitation from nobody in particular is one they ignore, or worse,
    /// report as a phishing attempt.
    /// </remarks>
    private string OpenedBy { get; set; } = "An administrator";

    private InviteInput _input = new();

    [SupplyParameterFromForm]
    private InviteInput Input
    {
        get => _input;
        set => _input = value ?? new InviteInput();
    }

    private List<AccountRow> Rows { get; set; } = [];

    private (string Name, string Link, bool Sent)? Invited { get; set; }

    private string? Refusal { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationState).User;

        OpenedBy = user.FindFirst("display_name")?.Value
            ?? user.Identity?.Name
            ?? OpenedBy;

        await LoadAsync();
    }

    private async Task LoadAsync() => Rows = await Directory.AllAsync();

    private async Task Invite()
    {
        Refusal = null;
        Invited = null;

        try
        {
            var (user, link, sent) = await Administration.InviteAndTellThemAsync(
                Input.Email, Input.DisplayName, Input.JobTitle, BaseAddress, OpenedBy);

            Invited = (user.DisplayName, link, sent);
            Input = new InviteInput();
        }
        catch (Exception exception) when (
            exception is InvalidOperationException or ArgumentException)
        {
            Refusal = exception.Message;
        }

        await LoadAsync();
    }

    /// <summary>
    /// Where this application answers, taken from the request being served.
    /// </summary>
    /// <remarks>
    /// Read rather than configured, so a link handed out in development points
    /// at development and one handed out in production points at production,
    /// with nothing to keep in step.
    /// </remarks>
    private string BaseAddress =>
        Request is null
            ? string.Empty
            : $"{Request.Request.Scheme}://{Request.Request.Host}";

    private sealed class InviteInput
    {
        [Required(ErrorMessage = "A name is needed.")]
        [StringLength(200)]
        public string DisplayName { get; set; } = string.Empty;

        [Required(ErrorMessage = "An email address is needed.")]
        [EmailAddress(ErrorMessage = "That does not look like an email address.")]
        public string Email { get; set; } = string.Empty;

        [StringLength(150)]
        public string? JobTitle { get; set; }
    }
}
