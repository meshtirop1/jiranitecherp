@page "/set-password"
@using System.ComponentModel.DataAnnotations
@using JiranisokoTech.Infrastructure.Identity
@using Microsoft.AspNetCore.Authorization
@layout BareLayout
@attribute [AllowAnonymous]
@inject UserAdministration Administration

@*
    Anonymous, necessarily: somebody setting their first password has no way in
    yet. Static, like every page that changes a credential.
*@

<PageTitle>Set your password — Jiranisoko Delivery</PageTitle>

@if (Done)
{
    <h1 class="signin__title">That is set</h1>
    <p>You can sign in now.</p>
    <p><a href="/sign-in">Sign in</a></p>
}
else
{
    <h1 class="signin__title">Set your password</h1>
    <p class="signin__sub">@(Email ?? "Jiranisoko Tech Solutions")</p>

    <EditForm Model="Input" method="post" OnValidSubmit="Submit" FormName="set-password"
              class="signin__form">
        <DataAnnotationsValidator />

        @if (Refusal is not null)
        {
            <p class="signin__refusal" role="alert">@Refusal</p>
        }

        <div class="signin__field">
            <label for="password">Password</label>
            <InputText id="password" @bind-Value="Input.Password" type="password"
                       autocomplete="new-password" />
            <ValidationMessage For="() => Input.Password" />
        </div>

        <div class="signin__field">
            <label for="again">Again</label>
            <InputText id="again" @bind-Value="Input.Again" type="password"
                       autocomplete="new-password" />
            <ValidationMessage For="() => Input.Again" />
        </div>

        @*
            Twelve characters, and no rules about symbols. Length is what costs
            an attacker anything; a symbol requirement only produces Password1!
            on every account in the building.
        *@
        <p class="signin__note">
            Twelve characters or more. Nothing else is required — a long phrase
            you can remember beats a short one you cannot.
        </p>

        <button type="submit" class="signin__submit">Set it</button>
    </EditForm>
}

@code {
    [SupplyParameterFromQuery(Name = "email")]
    private string? Email { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    private string? Token { get; set; }

    private SetInput _input = new();

    [SupplyParameterFromForm]
    private SetInput Input
    {
        get => _input;
        set => _input = value ?? new SetInput();
    }

    private bool Done { get; set; }

    private string? Refusal { get; set; }

    private async Task Submit()
    {
        Refusal = null;

        if (string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Token))
        {
            Refusal = "That link is incomplete. Ask an administrator for another.";

            return;
        }

        try
        {
            await Administration.SetPasswordAsync(Email, Token, Input.Password);

            Done = true;
        }
        catch (Exception exception) when (exception is InvalidOperationException)
        {
            Refusal = exception.Message;
        }
    }

    private sealed class SetInput
    {
        [Required(ErrorMessage = "A password is needed.")]
        [StringLength(200, MinimumLength = 12,
            ErrorMessage = "Twelve characters or more.")]
        public string Password { get; set; } = string.Empty;

        /// <summary>
        /// Typed twice, because a typo in a password you cannot see locks you
        /// out of an account you have never used.
        /// </summary>
        [Compare(nameof(Password), ErrorMessage = "Those two do not match.")]
        public string Again { get; set; } = string.Empty;
    }
}
