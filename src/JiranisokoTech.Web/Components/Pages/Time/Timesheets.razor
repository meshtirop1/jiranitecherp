@page "/time/approvals"
@using System.Security.Claims
@using JiranisokoTech.Application.Authorization
@using JiranisokoTech.Application.Business
@using JiranisokoTech.Infrastructure.Business
@using JiranisokoTech.Infrastructure.People
@using Microsoft.AspNetCore.Authorization
@*
    Opening this needs time.view_all; approving needs time.approve. They were
    the same check before, which meant HR — who hold the first and not the
    second — could not see a timesheet at all, having been granted exactly that.
*@
@attribute [Authorize(Policy = PermissionClaim.PolicyPrefix + Permissions.TimeViewAll)]
@inject BusinessQueries Queries
@inject PeopleQueries People
@inject TimesheetService Service
@inject NavigationManager Navigation

@*
    Everything waiting, oldest day first — the opposite of the personal page,
    which shows the newest. An approver is working through a backlog and wants
    the thing that has been waiting longest; a person checking their own hours
    wants what they just typed.
*@

<PageTitle>Timesheets — Jiranisoko Delivery</PageTitle>

<div class="page-head">
    <h1>Timesheets</h1>
    <p class="subtle">@Waiting.Count waiting, @Total(Waiting.Sum(entry => entry.Minutes)) in all.</p>
</div>

@if (Refusal is not null)
{
    <p class="refusal" role="alert">@Refusal</p>
}

@*
    Shown alongside the refusal rather than instead of it. A bulk approval where nineteen
    worked and one did not is two facts, and somebody shown only the failure would re-tick
    nineteen entries that are already approved.
*@
@if (Done is not null)
{
    <p class="done" role="status">@Done</p>
}

@if (Me is null)
{
    <p class="refusal" role="alert">
        Your sign-in is not linked to a staff record. Approving time records who
        approved it, so there has to be somebody to record.
    </p>
}
else if (Waiting.Count == 0)
{
    <p class="empty">Nothing waiting. Everything logged has been approved.</p>
}
else
{
    <EditForm Model="Nothing" method="post" OnValidSubmit="ApproveChosen" FormName="bulk">
    <table class="grid">
        <caption class="visually-hidden">Hours waiting for approval</caption>
        <thead>
            <tr>
                <AuthorizeView Policy="@ApprovePolicy" Context="mayTick">
                    <th scope="col"><span class="visually-hidden">Choose</span></th>
                </AuthorizeView>
                <th scope="col">Who</th>
                <th scope="col">Day</th>
                <th scope="col">Hours</th>
                <th scope="col">Against</th>
                <th scope="col">What</th>
                <th scope="col"><span class="visually-hidden">Decision</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var entry in Waiting)
            {
                <tr>
                    <AuthorizeView Policy="@ApprovePolicy" Context="mayTick">
                        <td>
                            @*
                                Not offered for your own hours, because the domain refuses
                                them — a checkbox that could be ticked and then silently
                                skipped is worse than one that is not there, since somebody
                                would tick everything and believe it all went through.
                            *@
                            @if (entry.EmployeeId != Me)
                            {
                                <input type="checkbox" name="chosen" value="@entry.Id"
                                       aria-label="Approve this one too" />
                            }
                        </td>
                    </AuthorizeView>
                    <td>@entry.EmployeeName</td>
                    <td>@entry.On.ToString("ddd d MMM")</td>
                    <td class="number">@entry.Duration</td>
                    <td>@(entry.ProjectName ?? "—")</td>
                    <td>
                        @(entry.Note ?? "—")
                        @if (!entry.IsBillable)
                        {
                            <span class="pill pill--quiet">Not billable</span>
                        }
                    </td>
                    <td>
                        @if (entry.EmployeeId == Me)
                        {
                            @*
                                Nobody approves their own time. The domain refuses
                                it, so the button would only ever produce an error
                                — and a button that always fails teaches people to
                                ignore errors.
                            *@
                            <span class="subtle">Yours</span>
                        }
                        else
                        {
                            <AuthorizeView Policy="@ApprovePolicy" Context="mayApprove">
                                <Authorized>
                                    <form method="post" @formname="@($"approve-{entry.Id}")"
                                          @onsubmit="() => Approve(entry.Id)">
                                        <AntiforgeryToken />
                                        <button type="submit" class="button button--quiet">Approve</button>
                                    </form>
                                </Authorized>
                                <NotAuthorized>
                                    <span class="subtle">A manager signs these off.</span>
                                </NotAuthorized>
                            </AuthorizeView>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @*
        Approving one at a time is the ordinary case and approving a week of them is
        Friday afternoon. Everything ticked goes through one submission.
    *@
    <AuthorizeView Policy="@ApprovePolicy" Context="mayApproveMany">
        <p class="subtle">
            Tick whichever are right and approve them together. Anything the rules refuse
            is reported by name rather than skipped quietly.
        </p>

        <button type="submit" class="button">Approve the ones I have ticked</button>
    </AuthorizeView>
    </EditForm>
}

@if (Behind > 0)
{
    @*
        Said rather than hidden. A capped list that does not admit it is a list somebody
        clears and believes they have finished.
    *@
    <p class="subtle">
        @Behind.ToString("N0") more are waiting. Approve some of these and they will
        appear here.
    </p>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    private const string ApprovePolicy = PermissionClaim.PolicyPrefix + Permissions.TimeApprove;

    private Guid? Me { get; set; }

    private List<TimeRow> Waiting { get; set; } = [];

    private string? Refusal { get; set; }

    /// <summary>What went through, shown beside whatever did not.</summary>
    /// <remarks>
    /// Both at once, because a bulk approval where nineteen worked and one did not is two
    /// facts and a reader needs them both. Showing only the failure would leave somebody
    /// re-ticking nineteen entries that are already approved.
    /// </remarks>
    private string? Done { get; set; }

    /*
     * The ticked boxes are read off the request rather than from a bound model. This page is
     * statically rendered, so a checkbox list arrives in the form collection.
     */
    [CascadingParameter]
    private HttpContext? Request { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationState;

        if (Guid.TryParse(state.User.FindFirstValue(ClaimTypes.NameIdentifier), out var account))
        {
            Me = await People.EmployeeForAccountAsync(account);
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        /*
         * Capped, and the cap is visible on the screen rather than silent. This read every
         * unapproved entry there had ever been — fifty thousand of them at the volume the
         * scale check uses, all rendered into one table with a tick box each.
         *
         * A cap rather than a pager because of what the screen is for: somebody works
         * through this queue until it is empty, and paging a queue that is being emptied
         * moves rows under the reader between one page and the next. Oldest first, so the
         * cap always hides the least urgent, and it says how many are behind it.
         */
        var waiting = await Queries.TimeAsync(
            awaitingApprovalOnly: true, take: Ceiling + 1);

        Behind = Math.Max(0, waiting.Count - Ceiling);

        // Already oldest first from the query — see the note there on why the order and
        // the cap are one decision. Only the name within a day is settled here.
        Waiting = waiting
            .Take(Ceiling)
            .OrderBy(entry => entry.On)
            .ThenBy(entry => entry.EmployeeName)
            .ToList();
    }

    /// <summary>
    /// How many entries are shown at once.
    /// </summary>
    /// <remarks>
    /// Two hundred: more than anybody approves in a sitting, few enough that the page is
    /// one table and not a two-megabyte document with two hundred tick boxes in it.
    /// </remarks>
    private const int Ceiling = 200;

    /// <summary>How many more are waiting than fit on the page.</summary>
    private int Behind { get; set; }

    private object Nothing { get; } = new();

    /// <summary>
    /// Approve everything that was ticked, and say what could not be.
    /// </summary>
    /// <remarks>
    /// Each one is approved on its own rather than in one transaction, which is deliberate.
    /// A single transaction would mean one entry the rules refuse — somebody's own hours
    /// slipped in, an entry already approved by a colleague a minute ago — rolling back
    /// nineteen that were fine, and Friday afternoon spent working out which.
    ///
    /// So the ones that work go through, the ones that do not are named, and the screen says
    /// both. What is never done is skipping a failure quietly: somebody who ticked twenty and
    /// was told nothing would believe twenty went through.
    /// </remarks>
    private async Task ApproveChosen()
    {
        Refusal = null;
        Done = null;

        // Read off the posted form rather than bound: a set of checkboxes under one name is
        // a list, and the binder hands back only what was ticked.
        var chosen = Request?.Request.Form["chosen"].ToArray() ?? [];

        if (chosen.Length == 0)
        {
            Refusal = "Nothing was ticked.";
            await LoadAsync();
            return;
        }

        var approved = 0;
        var refused = new List<string>();

        foreach (var value in chosen)
        {
            if (!Guid.TryParse(value, out var entryId))
            {
                continue;
            }

            try
            {
                await Service.ApproveAsync(entryId, Me!.Value);
                approved++;
            }
            catch (Exception exception) when (
                exception is ArgumentException or InvalidOperationException)
            {
                var whose = Waiting.FirstOrDefault(entry => entry.Id == entryId);

                refused.Add(whose is null
                    ? exception.Message
                    : $"{whose.EmployeeName}, {whose.On:ddd d MMM}: {exception.Message}");
            }
        }

        if (approved > 0)
        {
            Done = $"{approved} {(approved == 1 ? "entry" : "entries")} approved.";
        }

        if (refused.Count > 0)
        {
            Refusal = string.Join(" ", refused);
        }

        await LoadAsync();
    }

    private async Task Approve(Guid entryId)
    {
        Refusal = null;

        try
        {
            await Service.ApproveAsync(entryId, Me!.Value);
            Navigation.NavigateTo("/time/approvals", forceLoad: true);
        }
        catch (InvalidOperationException exception)
        {
            Refusal = exception.Message;
            await LoadAsync();
        }
    }

    private static string Total(int minutes) =>
        minutes % 60 == 0 ? $"{minutes / 60}h" : $"{minutes / 60}h {minutes % 60}m";
}
