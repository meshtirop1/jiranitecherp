@page "/people/{id:guid}"
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using JiranisokoTech.Application.Authorization
@using JiranisokoTech.Application.Documents
@using JiranisokoTech.Application.Abstractions
@using JiranisokoTech.Application.People
@using JiranisokoTech.Domain.Documents
@using JiranisokoTech.Domain.People
@using JiranisokoTech.Infrastructure.People
@using JiranisokoTech.Web.Authorization
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = PermissionClaim.PolicyPrefix + Permissions.EmployeesView)]
@inject PeopleQueries People
@inject PeopleService Service
@inject DocumentService Files
@inject IPeopleRepository Staff
@inject IClock Clock
@inject TeamService TeamsService

@*
    Static, like everything that changes something.

    Each form carries its own model, bound by form name. Several forms on one
    statically rendered page is the case that needs saying out loud: the browser
    posts one of them, the framework matches the posted handler to the form
    name, and only that form's model is filled. Without the FormName on each
    [SupplyParameterFromForm] they would all try to bind the same post.
*@

<PageTitle>@(Row?.FullName ?? "Person") — Jiranisoko Delivery</PageTitle>

@if (Row is null)
{
    <h1>Not on the staff list</h1>
    <p>There is nobody here with that identifier.</p>
    <p><a href="/people">Back to people</a></p>
}
else
{
    <div class="page-head">
        <h1>@Row.FullName</h1>
        <span class="pill pill--@Row.Status.ToString().ToLowerInvariant()">@Row.Status</span>
    </div>

    <div class="portrait">
        @if (Photo is { } photo)
        {
            <img src="/documents/@photo.Id" alt="@Row.FullName" class="portrait__image" />
        }
        else
        {
            @*
                Initials rather than a silhouette. A generic outline of a person says
                nothing and looks like a fault; two letters at least identify who is
                missing a photograph.
            *@
            <span class="portrait__initials" aria-hidden="true">@Initials(Row.FullName)</span>
        }

        <p class="subtle">@(Row.JobTitle ?? "No job title recorded")</p>
    </div>

    <AuthorizeView Policy="@ManagePolicy" Context="mayPhoto">
        <EditForm Model="Nothing" method="post" OnValidSubmit="AttachPhoto" FormName="photo"
                  enctype="multipart/form-data" class="inline">
            <label>
                <span class="visually-hidden">A photograph</span>
                <input type="file" name="photo" accept="image/*" />
            </label>
            <button type="submit" class="button button--quiet">
                @(Photo is null ? "Add a photo" : "Replace the photo")
            </button>
        </EditForm>
    </AuthorizeView>

    @if (Refusal is not null)
    {
        @* Shown as the service wrote it. Those messages say what to do
           differently, which a generic apology throws away. *@
        <p class="refusal" role="alert">@Refusal</p>
    }

    @if (Done is not null)
    {
        <p class="done" role="status">@Done</p>
    }

    <dl class="facts">
        <dt>Department</dt>
        <dd>@(Row.DepartmentName ?? "None")</dd>

        @*
            Their teams, next to their department, because the pair is what this page is asked
            for: the department is where they sit and the teams are what they are working on.
            Behind teams.view rather than shown to everybody who may open a staff record — the
            two permissions are held by different people on purpose.
        *@
        <AuthorizeView Policy="@TeamsPolicy" Context="maySeeTeams">
            <dt>Teams</dt>
            <dd>
                @if (Teams.Count == 0)
                {
                    <span class="subtle">On no team at the moment</span>
                }
                else
                {
                    <ul class="plain">
                        @foreach (var team in Teams)
                        {
                            <li><a href="/teams/@team.Slug">@team.Name</a></li>
                        }
                    </ul>
                }
            </dd>
        </AuthorizeView>

        <dt>Reports to</dt>
        <dd>
            @if (Row.ReportsToId is { } manager)
            {
                <a href="/people/@manager">@Row.ReportsToName</a>
            }
            else
            {
                <text>Nobody — top of the firm</text>
            }
        </dd>

        <dt>@(Row.Status == EmploymentStatus.Invited ? "Starts" : "Started")</dt>
        <dd>@Row.StartsOn.ToString("d MMMM yyyy")</dd>

        <dt>Capacity</dt>
        <dd>@Row.WeeklyCapacityHours hours a week</dd>

        <dt>Sign-in</dt>
        <dd>@(Row.HasAccount ? "Has an account" : "No account yet")</dd>
    </dl>

    @if (Reports.Count > 0)
    {
        <h2>Reports to @Row.FullName</h2>
        <ul class="reports">
            @foreach (var report in Reports)
            {
                <li>
                    <a href="/people/@report.Id">@report.FullName</a>
                    — @(report.JobTitle ?? "no job title")
                </li>
            }
        </ul>
    }

    <AuthorizeView Policy="@ManagePolicy" Context="permitted">
        <h2>Employment</h2>

        <div class="actions">
            @if (Row.Status == EmploymentStatus.Invited)
            {
                <form method="post" @formname="start" @onsubmit="Start">
                    <AntiforgeryToken />
                    <button type="submit">Record that they have started</button>
                </form>
            }

            @if (Row.Status == EmploymentStatus.Active)
            {
                <EditForm Model="Suspension" method="post" FormName="suspend"
                          OnValidSubmit="Suspend" class="inline">
                    <DataAnnotationsValidator />
                    <InputText @bind-Value="Suspension.Reason" placeholder="Why" />
                    <button type="submit">Suspend</button>
                    <ValidationMessage For="() => Suspension.Reason" />
                </EditForm>
            }

            @if (Row.Status is EmploymentStatus.Suspended or EmploymentStatus.Left)
            {
                <form method="post" @formname="reinstate" @onsubmit="Reinstate">
                    <AntiforgeryToken />
                    <button type="submit">Reinstate</button>
                </form>
            }
        </div>

        @if (Row.Status != EmploymentStatus.Left)
        {
            @*
                Leaving asks for a date and a reason rather than being one
                button: it is the hardest change to undo, and those two facts
                are exactly what somebody is asked for months later.
            *@
            <h2>Record that they have left</h2>

            <EditForm Model="Leaving" method="post" FormName="leave"
                      OnValidSubmit="Leave" class="inline">
                <DataAnnotationsValidator />
                <InputDate @bind-Value="Leaving.On" />
                <InputText @bind-Value="Leaving.Reason" placeholder="Reason" />
                <button type="submit" class="danger">Record it</button>
                <ValidationMessage For="() => Leaving.Reason" />
            </EditForm>
        }

        <h2>Reporting line</h2>

        <EditForm Model="Line" method="post" FormName="line" OnValidSubmit="SetLine" class="inline">
            <InputSelect @bind-Value="Line.ManagerId">
                <option value="">Nobody — top of the firm</option>
                @foreach (var candidate in Candidates)
                {
                    <option value="@candidate.Id">@candidate.FullName</option>
                }
            </InputSelect>
            <button type="submit">Set</button>
        </EditForm>

        <h2>Department</h2>

        <EditForm Model="Placement" method="post" FormName="department"
                  OnValidSubmit="Move" class="inline">
            <InputSelect @bind-Value="Placement.DepartmentId">
                <option value="">None</option>
                @foreach (var (id, name) in Departments.OrderBy(entry => entry.Value))
                {
                    <option value="@id">@name</option>
                }
            </InputSelect>
            <button type="submit">Move</button>
        </EditForm>
    </AuthorizeView>

    @*
        The personnel file is not drawn for everybody who can open this page.

        The page asks for employees.view, which HR, every department head, every
        delivery manager, the administrator and the owner hold, because a roster
        is meant to be read widely. What gets attached to a person is not: a
        contract with a salary on it, a disciplinary letter, a scan of a
        passport. Copying the client page as it stands would have drawn that list
        for every delivery manager in the firm, so it is drawn instead for
        employees.manage and for the person the record is about — the same rule
        the download endpoint applies, and it is the endpoint that is the
        protection. Hiding the list is only so that nobody is shown a column of
        links that all answer "no such document".

        Reaching your own file this way still means getting through the door
        first, and the door is employees.view, which an engineer does not hold.
        So self-access works at the endpoint and is linked from no page they can
        open. It wants a page about yourself rather than about somebody, and
        there is not one yet.
    *@
    @if (MayReadTheFile)
    {
        <section class="standing">
            <h2>Attached</h2>

            @if (Attached.Count == 0)
            {
                <p class="empty">
                    Nothing attached. A contract, a certificate or an identity document belongs here.
                </p>
            }
            else
            {
                <ul class="plain">
                    @foreach (var file in Attached)
                    {
                        <li>
                            <a href="/documents/@file.Id">@file.FileName</a>
                            <span class="subtle">
                                @file.Size, @file.UploadedAt.ToString("d MMM yyyy")@(file.Note is { } note ? $" — {note}" : null)
                            </span>
                        </li>
                    }
                </ul>
            }

            <AuthorizeView Policy="@ManagePolicy" Context="mayAttach">
                <EditForm Model="Attaching" method="post" OnValidSubmit="Attach" FormName="attach"
                          enctype="multipart/form-data" class="inline">
                    <label>
                        <span class="visually-hidden">A file</span>
                        <input type="file" name="document" />
                    </label>
                    <InputText @bind-Value="Attaching.Note" placeholder="What it is" />
                    <button type="submit" class="button button--quiet">Attach</button>
                </EditForm>
            </AuthorizeView>
        </section>
    }

    @*
        The rest of the record — contact details, next of kin, terms, skills and
        qualifications — in its own component. This page was already long, and none
        of that is about employment state, which is what the sections above are.
    *@
    <StaffRecord Person="Record" Today="Today" />

    <p><a href="/people">Back to people</a></p>
}

@code {
    private const string ManagePolicy =
        PermissionClaim.PolicyPrefix + Permissions.EmployeesManage;

    private const string TeamsPolicy = PermissionClaim.PolicyPrefix + Permissions.TeamsView;

    [Parameter]
    public Guid Id { get; set; }

    /*
     * The upload is read off the request rather than from a bound model.
     *
     * This page is statically rendered, so InputFile never runs and @onchange
     * never fires — there is no circuit to fire them on. A plain file input
     * inside a multipart form posts the bytes with everything else, and this is
     * where they arrive.
     */
    [CascadingParameter]
    private HttpContext? Request { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    /*
     * Each of these is backed by a field whose setter refuses null.
     *
     * The binder assigns every form model on every post, including the four
     * that were not the one submitted, and for those it assigns null. A plain
     * auto-property with an initializer is therefore null exactly when another
     * form on the page was used, and the page throws while rendering.
     */
    private SuspensionInput _suspension = new();
    private LeavingInput _leaving = new();
    private LineInput _line = new();
    private PlacementInput _placement = new();
    private AttachInput _attaching = new();

    [SupplyParameterFromForm(FormName = "suspend")]
    private SuspensionInput Suspension
    {
        get => _suspension;
        set => _suspension = value ?? new SuspensionInput();
    }

    [SupplyParameterFromForm(FormName = "leave")]
    private LeavingInput Leaving
    {
        get => _leaving;
        set => _leaving = value ?? new LeavingInput();
    }

    [SupplyParameterFromForm(FormName = "line")]
    private LineInput Line
    {
        get => _line;
        set => _line = value ?? new LineInput();
    }

    [SupplyParameterFromForm(FormName = "department")]
    private PlacementInput Placement
    {
        get => _placement;
        set => _placement = value ?? new PlacementInput();
    }

    [SupplyParameterFromForm(FormName = "attach")]
    private AttachInput Attaching
    {
        get => _attaching;
        set => _attaching = value ?? new AttachInput();
    }

    private PersonRow? Row { get; set; }

    /// <summary>
    /// The staff record itself, not the row the list shows.
    /// </summary>
    /// <remarks>
    /// Read as the entity because the sections below it are about owned values —
    /// contact details, terms, skills — and flattening those into a query row would
    /// mean a second shape of the same data for a screen that writes them back.
    /// </remarks>
    private Employee? Record { get; set; }

    private DateOnly Today { get; set; }

    /// <summary>The most recent photograph, which is the current one.</summary>
    /// <remarks>
    /// The last rather than the only. Replacing a photo attaches a new file instead of
    /// overwriting the old one, because the document store is append-only and a
    /// replaced portrait is not something worth building a delete path for.
    /// </remarks>
    private Attachment? Photo { get; set; }

    /// <summary>A model for the photograph form, which carries only a file.</summary>
    private object Nothing { get; } = new();

    private List<PersonRow> Reports { get; set; } = [];

    private List<PersonRow> Candidates { get; set; } = [];

    private Dictionary<Guid, string> Departments { get; set; } = [];

    private List<Team> Teams { get; set; } = [];

    private List<Attachment> Attached { get; set; } = [];

    /// <summary>The staff record behind the sign-in reading this page, if any.</summary>
    private Guid? Me { get; set; }

    private bool MayReadTheFile { get; set; }

    private string? Refusal { get; set; }

    private string? Done { get; set; }

    private bool _loaded;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthenticationState).User;

        if (Guid.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var account))
        {
            Me = await People.EmployeeForAccountAsync(account);
        }

        /*
         * Both sides have to be a real person.
         *
         * An account with no staff record resolves to nobody, and nobody is not
         * the person this page is about. Written out rather than left to a
         * lifted comparison happening to be false, because the work item page
         * made the same mistake in the shape where it does not: two nullable
         * identifiers, null matching null, and every engineer could read every
         * unassigned card.
         */
        MayReadTheFile = user.HasPermission(Permissions.EmployeesManage)
            || (Me is { } me && me == Id);

        await LoadAsync();
    }

    /// <summary>
    /// Attach a photograph, read straight off the posted form.
    /// </summary>
    /// <remarks>
    /// A plain file input rather than InputFile, because this page is statically
    /// rendered: there is no circuit, so InputFile never runs and @onchange never
    /// fires. The bytes arrive with the rest of the multipart body.
    /// </remarks>
    private async Task AttachPhoto()
    {
        Refusal = null;

        var file = Request?.Request.Form.Files["photo"];

        if (file is null || file.Length == 0)
        {
            Refusal = "Choose an image first.";
            await LoadAsync();
            return;
        }

        try
        {
            await using var contents = file.OpenReadStream();

            await Files.AttachAsync(
                AttachedTo.Photo, Id, contents, file.FileName, file.Length, Me, "Photograph");

            Done = "The photograph has been attached.";
            await LoadAsync();
        }
        catch (Exception exception) when (
            exception is ArgumentException or InvalidOperationException)
        {
            Refusal = exception.Message;
            await LoadAsync();
        }
    }

    /// <summary>
    /// Two letters from a name.
    /// </summary>
    /// <remarks>
    /// Shown where a photograph is missing. A generic silhouette says nothing and
    /// reads as a fault; initials at least identify whose photograph is absent.
    /// </remarks>
    private static string Initials(string fullName)
    {
        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..1].ToUpperInvariant(),
            _ => (parts[0][..1] + parts[^1][..1]).ToUpperInvariant(),
        };
    }

    private async Task LoadAsync()
    {
        var roster = await People.RosterAsync();

        Row = roster.FirstOrDefault(person => person.Id == Id);
        Record = await Staff.FindAsync(Id);
        Today = Clock.Today;

        /*
         * Read for anybody who may open this page, unlike the personnel file below.
         * A photograph is what a colleague looks at to work out who they are about to
         * meet; hiding it behind the permission that guards salaries would produce a
         * directory of grey squares.
         */
        Photo = (await Files.ForAsync(AttachedTo.Photo, Id)).LastOrDefault();
        Reports = roster.Where(person => person.ReportsToId == Id).ToList();
        Departments = await People.DepartmentNamesAsync();
        Teams = await TeamsService.ForEmployeeAsync(Id);

        // Read only when it is going to be drawn. The query is cheap, but this
        // is a personnel file, and holding one in the state of a page rendered
        // for somebody who may not see it is one careless @Attached away from
        // putting a disciplinary letter on a colleague's screen.
        Attached = MayReadTheFile ? await Files.ForAsync(AttachedTo.Employee, Id) : [];

        // Somebody who has left cannot be given reports or a post, so they are
        // not offered. A refusal after the click is a worse way to say so.
        Candidates = roster
            .Where(person => person.Id != Id && person.Status != EmploymentStatus.Left)
            .ToList();

        // Only on the first pass: after a post, these hold what was submitted,
        // and overwriting them would discard the change being made.
        if (!_loaded && Row is not null && FirstLook.ThisTime(Request))
        {
            Line.ManagerId = Row.ReportsToId;
            Placement.DepartmentId = Row.DepartmentId;
            _loaded = true;
        }
    }

    private Task Start() => Run(() => Service.StartAsync(Id), "Recorded as started.");

    private Task Suspend() =>
        Run(() => Service.SuspendAsync(Id, Suspension.Reason), "Suspended.");

    private Task Reinstate() => Run(() => Service.ReinstateAsync(Id), "Back at work.");

    private Task Leave() => Run(
        async () =>
        {
            var moved = await Service.RecordLeavingAsync(Id, Leaving.On, Leaving.Reason);

            Done = moved == 0
                ? "Recorded as having left."
                : $"Recorded as having left. {moved} now report to their manager.";
        },
        done: null);

    private Task SetLine() =>
        Run(() => Service.SetReportingLineAsync(Id, Line.ManagerId), "Reporting line changed.");

    private Task Move() =>
        Run(() => Service.MoveAsync(Id, Placement.DepartmentId), "Moved.");

    private Task Attach() => Run(
        async () =>
        {
            var file = Request?.Request.Form.Files["document"];

            if (file is not { Length: > 0 })
            {
                throw new InvalidOperationException("Choose a file first.");
            }

            await using var contents = file.OpenReadStream();

            // Recorded against the staff record of whoever is signed in, not
            // their account, so a personnel file says which colleague put the
            // contract there in the words the rest of the system uses. Null when
            // the account has no staff record, which the column allows.
            await Files.AttachAsync(
                AttachedTo.Employee, Id, contents, file.FileName, file.Length, Me, Attaching.Note);
        },
        "Attached.");

    private async Task Run(Func<Task> work, string? done)
    {
        Refusal = null;
        Done = null;

        try
        {
            await work();
            Done ??= done;
        }
        catch (Exception exception) when (
            exception is InvalidOperationException or ArgumentException)
        {
            Refusal = exception.Message;
        }

        await LoadAsync();
    }

    private sealed class SuspensionInput
    {
        [Required(ErrorMessage = "Say why. Somebody will ask later.")]
        [StringLength(500)]
        public string Reason { get; set; } = string.Empty;
    }

    private sealed class LeavingInput
    {
        public DateOnly On { get; set; } = DateOnly.FromDateTime(DateTime.UtcNow);

        [Required(ErrorMessage = "Say why. Somebody will ask later.")]
        [StringLength(500)]
        public string Reason { get; set; } = string.Empty;
    }

    private sealed class LineInput
    {
        public Guid? ManagerId { get; set; }
    }

    private sealed class PlacementInput
    {
        public Guid? DepartmentId { get; set; }
    }

    private sealed class AttachInput
    {
        [StringLength(500)]
        public string? Note { get; set; }
    }
}
