@page "/error"
@using System.Diagnostics
@using Microsoft.AspNetCore.Authorization
@layout BareLayout
@attribute [AllowAnonymous]

@*
    Anonymous for the same reason as the not-found page: the exception handler
    re-executes to this path, and a failure while signed out must still be able
    to say so.

    It deliberately says nothing about the fault. An exception message on an
    error page is a gift to somebody probing the application, and it is useless
    to the person reading it — the detail belongs in the log, keyed by the
    reference below.
*@

<PageTitle>Something went wrong — Jiranisoko Delivery</PageTitle>

<h1 class="bare__heading">Something went wrong</h1>

<p>
    The request could not be completed. This has been recorded; nothing you did
    caused it and trying again is worth a go.
</p>

@if (!string.IsNullOrEmpty(RequestId))
{
    <p class="bare__reference">
        Quote this reference if you report it: <code>@RequestId</code>
    </p>
}

<p><a href="/">Back to your work</a></p>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
