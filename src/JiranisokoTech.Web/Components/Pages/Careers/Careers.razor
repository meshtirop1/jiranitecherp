@page "/careers"
@using JiranisokoTech.Domain.Recruitment
@using JiranisokoTech.Infrastructure.Recruitment
@using Microsoft.AspNetCore.Authorization
@layout CareersLayout
@attribute [AllowAnonymous]
@inject RecruitmentQueries Queries
@inject JiranisokoTech.Application.Settings.SettingsService Settings

@*
    The only page in this application a stranger is meant to read, and the one
    that has to work for somebody on a phone with a bad connection. Static, no
    scripts of its own, nothing to wait for.
*@

<PageTitle>Work with us — @Firm</PageTitle>

<h1 class="careers__title">Work with us</h1>

@if (Openings.Count == 0)
{
    @*
        Said plainly rather than left as an empty page. Somebody who followed a
        link here needs to know the list is empty and not broken.
    *@
    <p>
        There are no openings at the moment. We advertise here when there are,
        so it is worth looking again.
    </p>
}
else
{
    <p class="careers__lead">
        @Openings.Count @(Openings.Count == 1 ? "opening" : "openings") at @Firm.
    </p>

    <ul class="careers__list">
        @foreach (var opening in Openings)
        {
            <li class="careers__opening">
                <a class="careers__role" href="/careers/@opening.Slug">@opening.Title</a>

                @if (opening.Location is { } where)
                {
                    <span class="careers__where">@where</span>
                }

                <p class="careers__summary">@opening.Summary</p>
            </li>
        }
    </ul>
}

@code {
    private List<OpeningRow> Openings { get; set; } = [];

    /// <summary>
    /// The firm's own name, for the title of the one page a stranger reads.
    /// </summary>
    /// <remarks>
    /// Read rather than typed. It used to be a literal here and in six other places, so renaming
    /// the firm renamed it on invoices and not on the page a candidate is looking at — and it is
    /// also what makes a demonstration copy of this application say so in its own title rather
    /// than advertising a real-looking job.
    /// </remarks>
    private string Firm { get; set; } = Words.TheFirm;

    protected override async Task OnInitializedAsync()
    {
        Openings = await Queries.OpeningsAsync();
        Firm = (await Settings.CurrentAsync()).TradingName;
    }
}
