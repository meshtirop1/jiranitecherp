@page "/work/{id:guid}"
@using System.ComponentModel.DataAnnotations
@using JiranisokoTech.Application.Authorization
@using JiranisokoTech.Application.Work
@using JiranisokoTech.Domain.People
@using JiranisokoTech.Domain.Work
@using JiranisokoTech.Infrastructure.People
@using JiranisokoTech.Domain.Engineering
@using JiranisokoTech.Infrastructure.Engineering
@using JiranisokoTech.Infrastructure.Work
@using System.Security.Claims
@using JiranisokoTech.Web.Authorization
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = PermissionClaim.PolicyPrefix + Permissions.TasksViewOwn)]
@inject WorkQueries Queries
@inject PeopleQueries People
@inject WorkService Service
@inject EngineeringQueries Engineering

<PageTitle>@(Row?.Title ?? "Work") — Jiranisoko Delivery</PageTitle>

@if (Row is not null && !MayRead)
{
    @* Holding tasks.view_own is permission to see your own work, not
       everybody's. Said as a refusal rather than as "no such work", because
       pretending a record does not exist to somebody who can see it on a
       colleague's screen only wastes their afternoon. *@
    <h1>Not yours to read</h1>
    <p>This work belongs to somebody else, and your account can only see its own.</p>
    <p><a href="/work">Back to the board</a></p>
}
else if (Row is null)
{
    <h1>No such work</h1>
    <p><a href="/work">Back to the board</a></p>
}
else
{
    <div class="page-head">
        @*
            The reference before the title, because it is the part somebody has
            to carry into a branch name and the title is the part they already
            know. A number nobody can see is a link nobody makes.
        *@
        <h1><span class="reference">@Row.Reference</span> @Row.Title</h1>
        <span class="pill">@Name(Row.Status)</span>
    </div>

    @if (Refusal is not null)
    {
        <p class="refusal" role="alert">@Refusal</p>
    }

    @if (Done is not null)
    {
        <p class="done" role="status">@Done</p>
    }

    <dl class="facts">
        <dt>Project</dt>
        <dd>@(Row.ProjectName ?? "None")</dd>

        <dt>Assigned to</dt>
        <dd>@(Row.AssigneeName ?? "Nobody")</dd>

        <dt>Priority</dt>
        <dd>@Row.Priority</dd>

        <dt>Estimate</dt>
        <dd>@(Row.Estimate ?? "Not estimated")</dd>

        <dt>Due</dt>
        <dd>@(Row.DueOn?.ToString("d MMMM yyyy") ?? "No date")</dd>

        @if (Row.BlockedReason is { } reason)
        {
            <dt>Blocked by</dt>
            <dd>@reason</dd>
        }
    </dl>

    @if (Moves.Count > 0)
    {
        <h2>Move it</h2>

        <div class="actions">
            @*
                Only the moves the state machine allows, narrowed to the ones
                this person may actually make. Two filters, and both matter:
                showing every column and refusing four after the click teaches
                people to distrust the buttons, and showing a move somebody is
                not permitted teaches them the same thing more slowly.
            *@
            @foreach (var next in Moves.Where(status => status != WorkItemStatus.Blocked))
            {
                <form method="post" @formname="@($"move-{next}")"
                      @onsubmit="() => Move(next, null)">
                    <AntiforgeryToken />
                    <button type="submit" class="@(next == WorkItemStatus.Cancelled ? "danger" : "")">
                        @Name(next)
                    </button>
                </form>
            }

            @if (Moves.Contains(WorkItemStatus.Blocked))
            {
                <EditForm Model="Block" method="post" FormName="block"
                          OnValidSubmit="() => Move(WorkItemStatus.Blocked, Block.Reason)"
                          class="inline">
                    <DataAnnotationsValidator />
                    <InputText @bind-Value="Block.Reason" placeholder="What is blocking it" />
                    <button type="submit">Blocked</button>
                    <ValidationMessage For="() => Block.Reason" />
                </EditForm>
            }
        </div>

    }

    @* Giving work to somebody is still the board-runner's act, not the
       worker's, so it keeps its own permission. *@
    <AuthorizeView Policy="@AssignPolicy" Context="permitted">
        <h2>Assign it</h2>

        <EditForm Model="Assignment" method="post" FormName="assign"
                  OnValidSubmit="Assign" class="inline">
            <InputSelect @bind-Value="Assignment.AssigneeId">
                <option value="">Nobody</option>
                @foreach (var person in Staff)
                {
                    <option value="@person.Id">@person.FullName</option>
                }
            </InputSelect>
            <button type="submit">Set</button>
        </EditForm>
    </AuthorizeView>

    @*
        What the repositories say was done. The whole point of watching them:
        nobody wrote any of this, and the reference in a branch name is the only
        thing that put it here.
    *@
    <AuthorizeView Policy="@ReposPolicy" Context="permitted">
        <h2>What was built</h2>

        @if (Evidence.IsEmpty)
        {
            <p class="empty">
                Nothing has arrived from a repository against
                <code>@Row.Reference</code>. Naming a branch
                <code>@($"feature/{Row.Number}-something")</code>, or writing
                <code>@Row.Reference</code> in a commit message, is what ties the
                two together.
            </p>
        }
        else
        {
            @*
                The one line this panel exists to produce. "Was it built, did it pass,
                where has it got to" is the question somebody opens a work item to
                answer, and answering it by making them read the newest row of two
                tables and carry both in their head is how a panel like this stops
                being read at all.

                Drawn only once something has actually reported a build or a
                deployment. A firm whose host sends commits but no workflow runs would
                otherwise be told "nothing has reported a build" on every task it ever
                opened — which reads as a fault in the work rather than as a gap in
                what this system is being sent, and the second one is nobody's job to
                fix on this page.
            *@
            @if (Evidence.Builds.Count > 0 || Evidence.Deployments.Count > 0)
            {
                <p>
                    @if (Evidence.LatestBuild is { } latest)
                    {
                        <span class="pill @Tone(latest.Outcome)">
                            @Words.For(latest.Outcome)
                        </span>
                    }
                    @Standing
                </p>
            }

            @if (Evidence.PullRequests.Count > 0)
            {
                <table class="grid">
                    <caption class="visually-hidden">Pull requests</caption>
                    <thead>
                        <tr>
                            <th scope="col">Pull request</th>
                            <th scope="col">Branch</th>
                            <th scope="col">By</th>
                            <th scope="col">Reviews</th>
                            <th scope="col">State</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pull in Evidence.PullRequests)
                        {
                            <tr>
                                <td>
                                    <strong>#@pull.Number</strong> @pull.Title
                                    <span class="subtle">@pull.Repository</span>
                                </td>
                                <td><code>@pull.Branch</code></td>
                                <td>@pull.Author</td>
                                <td>
                                    @if (pull.Reviews == 0)
                                    {
                                        <span class="subtle">None yet</span>
                                    }
                                    else if (pull.IsApproved)
                                    {
                                        <span class="pill pill--done">Approved</span>
                                    }
                                    else
                                    {
                                        @* Changes asked for, or comments only.
                                           Either way it is not approved, and
                                           saying so is the useful half. *@
                                        <span class="pill pill--danger">Not approved</span>
                                    }
                                </td>
                                <td>
                                    <span class="pill @(pull.State == PullRequestState.Merged
                                        ? "pill--done" : "pill--quiet")">
                                        @Words.For(pull.State)
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            @if (Evidence.Commits.Count > 0)
            {
                <table class="grid">
                    <caption class="visually-hidden">Commits</caption>
                    <thead>
                        <tr>
                            <th scope="col">Commit</th>
                            <th scope="col">Branch</th>
                            <th scope="col">By</th>
                            <th scope="col">When</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var commit in Evidence.Commits)
                        {
                            <tr>
                                <td><code>@commit.Short</code> @commit.Message</td>
                                <td><code>@commit.Branch</code></td>
                                <td>@commit.Author</td>
                                <td>@commit.At.ToString("d MMM yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            @*
                Builds and deployments come after the commits and the review rather
                than before them, because that is the order the work happened in and a
                reader going down the panel is following one chain: somebody wrote it,
                somebody reviewed it, a machine built it, and it landed somewhere. The
                checklist calls the last two the missing links, and they are missing in
                that position.
            *@
            @if (Evidence.Builds.Count > 0)
            {
                <table class="grid">
                    <caption class="visually-hidden">Builds</caption>
                    <thead>
                        <tr>
                            <th scope="col">Build</th>
                            <th scope="col">Commit</th>
                            <th scope="col">Outcome</th>
                            <th scope="col">Took</th>
                            <th scope="col"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var build in Evidence.Builds)
                        {
                            <tr>
                                <td>
                                    @* A repository has several pipelines, and "the build
                                       failed" is not something anybody can act on until
                                       they know which one and off what branch. *@
                                    <strong>@build.Name</strong>
                                    <span class="subtle">@build.Branch</span>
                                </td>
                                <td><code>@build.Short</code></td>
                                <td>
                                    <span class="pill @Tone(build.Outcome)">
                                        @Words.For(build.Outcome)
                                    </span>
                                </td>
                                <td>
                                    @if (build.Took is { } took)
                                    {
                                        @took
                                    }
                                    else
                                    {
                                        @* A build that has not finished has no duration
                                           to report, and an empty cell beside a coloured
                                           pill reads as a build that took no time at
                                           all. Saying it is still going is the honest
                                           version of the same emptiness. *@
                                        <span class="subtle">Still going</span>
                                    }
                                </td>
                                <td>
                                    @if (build.Url is { } log)
                                    {
                                        @* The log stays on the host and this system
                                           deliberately keeps no copy of it, so the link
                                           is the whole of what somebody does next with a
                                           failure. Nothing is drawn when the host sent
                                           no address rather than a dead link. *@
                                        <a href="@log">Log</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            @if (Evidence.Deployments.Count > 0)
            {
                <table class="grid">
                    <caption class="visually-hidden">Deployments</caption>
                    <thead>
                        <tr>
                            <th scope="col">Where</th>
                            <th scope="col">Commit</th>
                            <th scope="col">State</th>
                            <th scope="col">When</th>
                            <th scope="col"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var deployment in Evidence.Deployments)
                        {
                            <tr>
                                <td>
                                    <strong>@Words.For(deployment.Environment)</strong>
                                    @if (deployment.NameAddsSomething)
                                    {
                                        @* Only where the host's own name for the place
                                           says more than the classification does. A firm
                                           deploying to "production" would otherwise read
                                           "Production production"; one deploying to
                                           prod-eu and prod-af cannot tell two production
                                           rows apart without it. *@
                                        <span class="subtle">@deployment.EnvironmentName</span>
                                    }
                                </td>
                                <td><code>@deployment.Short</code></td>
                                <td>
                                    <span class="pill @Tone(deployment.State)">
                                        @Words.For(deployment.State)
                                    </span>
                                </td>
                                <td>@deployment.At.ToString("d MMM yyyy HH:mm")</td>
                                <td>
                                    @if (deployment.Url is { } run)
                                    {
                                        <a href="@run">Look</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
    </AuthorizeView>

    @*
        Section 11's labels, dependencies, comments and acceptance criteria, as an interactive
        child rather than more forms on this page. Each of them needs a field inside a row — a
        tick beside one criterion, a word beside one label — and a per-row form with fields in it
        cannot bind under static rendering.
    *@
    <WorkParts WorkItemId="Id" />

    <p><a href="/work">Back to the board</a></p>
}

@code {
    private const string AssignPolicy = PermissionClaim.PolicyPrefix + Permissions.TasksAssign;

    private const string ReposPolicy = PermissionClaim.PolicyPrefix + Permissions.ReposView;

    [Parameter]
    public Guid Id { get; set; }

    private BlockInput _block = new();
    private AssignmentInput _assignment = new();

    [SupplyParameterFromForm(FormName = "block")]
    private BlockInput Block
    {
        get => _block;
        set => _block = value ?? new BlockInput();
    }

    [SupplyParameterFromForm(FormName = "assign")]
    private AssignmentInput Assignment
    {
        get => _assignment;
        set => _assignment = value ?? new AssignmentInput();
    }

    /// <summary>The request, only to tell a first look from a form post.</summary>
    [CascadingParameter]
    private HttpContext? Request { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    private WorkItemRow? Row { get; set; }

    private bool MayRead { get; set; }

    /// <summary>The moves this person may make from where the work is now.</summary>
    private IReadOnlyList<WorkItemStatus> Moves { get; set; } = [];

    private List<PersonRow> Staff { get; set; } = [];

    private string? Refusal { get; set; }

    private string? Done { get; set; }

    private WorkEvidence Evidence { get; set; } = new([], []);

    /// <summary>Where this work stands: what was built of it, and how far out it got.</summary>
    /// <remarks>
    /// Composed here rather than spelt out in the markup because the three endings are not
    /// one sentence with a word swapped. "Nothing has landed in an environment yet" and "it
    /// has not been deployed" are opposite pieces of news — the first is a deployment that
    /// went out and failed, which somebody has to go and look at, and the second is a stage
    /// nobody has reached, which is nothing at all. A reader given the wrong one of those
    /// either chases a release that was never attempted or ignores one that broke.
    ///
    /// Only ever says what the rows say. There is no figure here for how many builds passed
    /// or how long a deploy usually takes, because neither is in the evidence and a plausible
    /// number on a page like this is read as a measurement.
    /// </remarks>
    private string Standing
    {
        get
        {
            var built = Evidence.LatestBuild is { } latest
                ? $"{latest.Name} on {latest.Short}{(latest.Took is { } took ? $", {took}" : null)}."
                : "Nothing has reported a build.";

            if (Evidence.Furthest is { } furthest)
            {
                return $"{built} It has reached {Place(furthest)}.";
            }

            return Evidence.Deployments.Count > 0
                ? $"{built} Nothing has landed in an environment yet."
                : $"{built} It has not been deployed.";
        }
    }

    /// <summary>Where a deployment went, said inside a sentence.</summary>
    /// <remarks>
    /// Lower case because this lands mid-sentence and a capital there reads as the start of
    /// one, the same reason the move messages lower-case a status. The host's own name is
    /// left exactly as it arrived: prod-eu is an identifier somebody will search their CI for,
    /// and a version of it this page invented would not be found.
    /// </remarks>
    private static string Place(DeploymentRow deployment)
    {
        var classified = Words.For(deployment.Environment).ToLowerInvariant();

        return deployment.NameAddsSomething
            ? $"{classified} ({deployment.EnvironmentName})"
            : classified;
    }

    private bool _loaded;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        /*
         * By its identifier. This read every work item in the system and picked its own
         * out of the list — invisible with forty rows, and three quarters of a second and
         * eighty thousand objects per view at a hundred and twenty thousand.
         */
        Row = await Queries.ItemAsync(Id);

        var user = (await AuthenticationState).User;

        /*
         * Both sides have to be a real person.
         *
         * The first version compared Row.AssigneeId with the viewer, and both
         * were null for unassigned work read by somebody with no staff record —
         * so null equalled null and every engineer could read every unassigned
         * card. A test caught it; the equality alone reads as correct.
         */
        var viewer = Guid.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var account)
            ? await People.EmployeeForAccountAsync(account)
            : null;

        MayRead = user.HasPermission(Permissions.TasksViewAll)
            || (Row?.AssigneeId is { } owner && viewer is { } me && owner == me);

        /*
         * Which buttons to draw, decided by the same code the move itself asks.
         * Drawing and doing have to agree, and the only way to be sure of that
         * is that they are one function rather than two that look alike.
         */
        var held = user.FindAll(PermissionClaim.Type).Select(claim => claim.Value).ToHashSet();

        Moves = Row is null
            ? []
            : WorkPermissions.MovesFor(held, Row.Status, Row.AssigneeId, viewer);

        // Only people who can actually take it are offered, which is the same
        // rule the service enforces.
        Staff = await People.RosterAsync(status: EmploymentStatus.Active);

        if (Row is not null && MayRead)
        {
            Evidence = await Engineering.EvidenceForAsync(Row.Id);
        }

        /*
         * Only on a first look. The _loaded flag alone was not enough: under static
         * rendering every request is a new component instance, so on the POST it was false
         * again and this overwrote the assignee somebody had just chosen with the one already
         * stored — and the page then said "Assigned." See FirstLook.
         */
        if (!_loaded && Row is not null && FirstLook.ThisTime(Request))
        {
            Assignment.AssigneeId = Row.AssigneeId;
            _loaded = true;
        }
    }

    /// <summary>
    /// Checked again here, not only when the buttons were drawn.
    /// </summary>
    /// <remarks>
    /// Drawing fewer buttons is what somebody sees; this is what stops it. A
    /// form post carries a status and a form name, and nothing about a browser
    /// prevents either being whatever the sender likes — so the page that
    /// decides which moves to offer has to decide again when one arrives.
    /// The same function answers both, so the two cannot drift apart.
    /// </remarks>
    private Task Move(WorkItemStatus status, string? because) =>
        Moves.Contains(status)
            ? Run(
                () => Service.MoveAsync(Id, status, because),
                $"Moved to {Name(status).ToLowerInvariant()}.")
            : Refuse("That is not a move you can make on this piece of work.");

    private async Task Refuse(string why)
    {
        Refusal = why;
        Done = null;

        await LoadAsync();
    }

    private Task Assign() =>
        Run(() => Service.AssignAsync(Id, Assignment.AssigneeId), "Assigned.");

    private async Task Run(Func<Task> work, string done)
    {
        Refusal = null;
        Done = null;

        try
        {
            await work();
            Done = done;
        }
        catch (Exception exception) when (
            exception is InvalidOperationException or ArgumentException)
        {
            Refusal = exception.Message;
        }

        await LoadAsync();
    }

    /// <summary>The colour a build outcome gets, not the word for it.</summary>
    /// <remarks>
    /// The words are in <see cref="Words"/>, where every other screen gets them; this is only
    /// the pill. It is a method rather than the inline conditional the pull request column
    /// uses because four outcomes do not fit one, and because the summary line and the table
    /// under it have to agree: a failed build shown red in the sentence and grey in the table
    /// is a reader deciding this page is unreliable and going to the host to check, which is
    /// the habit the panel was built to remove.
    ///
    /// Cancelled is quiet rather than red on purpose. Somebody pushed again or the queue was
    /// drained; nothing was broken, and marking it as a failure puts a red row against work
    /// that was fine.
    /// </remarks>
    private static string Tone(BuildOutcome outcome) => outcome switch
    {
        BuildOutcome.Passed => "pill--done",
        BuildOutcome.Failed => "pill--danger",

        // Its own colour, not the waiting one. A build that is running is not queued.
        BuildOutcome.Running => "pill--running",

        /*
         * Amber rather than the quiet grey a cancelled build gets. A cancelled build asks
         * nothing of anybody; a blocked one is waiting for a person to open a gate, and drawn
         * the same colour the second one is invisible on a page somebody is scanning.
         */
        BuildOutcome.Blocked => "pill--wait",
        _ => "pill--quiet",
    };

    /// <remarks>
    /// Its own overload rather than a shared one over both enums, because a build and a
    /// deployment do not have the same middle: a build running is a wait, and a deployment
    /// running is the few minutes in which an environment is neither the old version nor the
    /// new one. They share the amber for now, and a change to either should not silently be a
    /// change to both.
    /// </remarks>
    private static string Tone(DeploymentState state) => state switch
    {
        DeploymentState.Succeeded => "pill--done",
        DeploymentState.Failed => "pill--danger",
        _ => "pill--running",
    };

    private static string Name(WorkItemStatus status) => status switch
    {
        WorkItemStatus.Todo => "To do",
        WorkItemStatus.InProgress => "In progress",
        WorkItemStatus.InReview => "In review",
        _ => status.ToString(),
    };

    private sealed class BlockInput
    {
        [Required(ErrorMessage = "Say what is blocking it.")]
        [StringLength(1000)]
        public string Reason { get; set; } = string.Empty;
    }

    private sealed class AssignmentInput
    {
        public Guid? AssigneeId { get; set; }
    }
}
