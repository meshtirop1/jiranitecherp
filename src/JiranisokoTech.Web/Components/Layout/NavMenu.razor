@using JiranisokoTech.Application.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject IServiceScopeFactory Scopes

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Jiranisoko Delivery</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

@* The handler that closes this drawer lives in wwwroot/nav.js. It was an
   inline onclick, which is the first thing a script-src policy refuses. *@
<div class="nav-scrollable">
    <nav class="nav flex-column">
        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
                    </NavLink>
                </div>

                <AuthorizeView Policy="@(PermissionClaim.PolicyPrefix + Permissions.UsersView)"
                               Context="accounts">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="accounting">Accounts</NavLink>
                    </div>
                </AuthorizeView>

                @* Its own entry rather than a link buried in the accounts, because running it
                   is a monthly errand somebody comes here specifically to do. *@
                <AuthorizeView Policy="@(PermissionClaim.PolicyPrefix + Permissions.PayrollView)"
                               Context="payroll">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="payroll">Payroll</NavLink>
                    </div>
                </AuthorizeView>

                <AuthorizeView Policy="@(PermissionClaim.PolicyPrefix + Permissions.RequisitionsView)"
                               Context="hiring">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="hiring">Hiring</NavLink>
                    </div>
                </AuthorizeView>

                <AuthorizeView Policy="@(PermissionClaim.PolicyPrefix + Permissions.ApprovalsDecide)"
                               Context="approvals">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="approvals">Approvals</NavLink>
                    </div>
                </AuthorizeView>

                <AuthorizeView Policy="@(PermissionClaim.PolicyPrefix + Permissions.TasksViewAll)"
                               Context="work">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="work">Work</NavLink>
                    </div>
                </AuthorizeView>

                <AuthorizeView Policy="@(PermissionClaim.PolicyPrefix + Permissions.ProjectsViewAll)"
                               Context="projects">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="projects">Projects</NavLink>
                    </div>
                </AuthorizeView>

                @*
                    Second only to the home page, and carrying its own count. A
                    notice is addressed to one person, so there is no permission
                    on it — the link is shown to anybody signed in, and the page
                    says plainly when a sign-in is not linked to a staff record.
                *@
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="notices">
                        Notices@(Unread > 0 ? $" ({Unread})" : "")
                    </NavLink>
                </div>

                @*
                    Next to the incidents, because the first thing anybody does in
                    one is ask what the broken thing is and who owns it.
                *@
                <AuthorizeView Policy="@(PermissionClaim.PolicyPrefix + Permissions.PlatformView)"
                               Context="platform">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="platform">Platform</NavLink>
                    </div>
                </AuthorizeView>

                @*
                    Above the repositories and carrying its own count, because an
                    open incident is the one thing in this application that should
                    be visible from every page. The count is of open ones only —
                    mitigated ones have stopped hurting anybody, and a number in
                    the navigation that does not clear trains people to ignore it.
                *@
                <AuthorizeView Policy="@(PermissionClaim.PolicyPrefix + Permissions.IncidentsView)"
                               Context="incidents">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="incidents">
                            Incidents@(Happening > 0 ? $" ({Happening})" : "")
                        </NavLink>
                    </div>
                </AuthorizeView>

                @*
                    Next to the board deliberately. The repositories are where
                    the work on that board actually happens, and what arrives
                    from them is the evidence the board is telling the truth.
                *@
                <AuthorizeView Policy="@(PermissionClaim.PolicyPrefix + Permissions.ReposView)"
                               Context="repositories">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="repositories">Repositories</NavLink>
                    </div>
                </AuthorizeView>

                @*
                    The three self-service links, first among the business ones
                    because they are what most people here open this system for.
                    Each sits behind the permission every working role holds, so
                    they are effectively always shown — which is the point.
                *@
                @*
                    No permission on this one: what a search finds is decided
                    per group inside the query, from the claims the person
                    actually holds. Putting a permission here would either hide
                    the box from most of the staff or promise them results they
                    cannot open.
                *@
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="search">Search</NavLink>
                </div>

                <AuthorizeView Policy="@(PermissionClaim.PolicyPrefix + Permissions.PostingsManage)"
                               Context="adverts">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="hiring/postings">Adverts</NavLink>
                    </div>
                </AuthorizeView>

                <AuthorizeView Policy="@(PermissionClaim.PolicyPrefix + Permissions.CandidatesView)"
                               Context="applications">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="hiring/applications">Applications</NavLink>
                    </div>
                </AuthorizeView>

                <AuthorizeView Policy="@(PermissionClaim.PolicyPrefix + Permissions.InterviewsView)"
                               Context="interviews">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="hiring/interviews">Interviews</NavLink>
                    </div>

                    @*
                        Beside interviews and under the same permission, because it is the same
                        grain of evidence about the same candidate — read by the same people to
                        make the same decision.
                    *@
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="hiring/assessments">Exercises</NavLink>
                    </div>
                </AuthorizeView>

                <AuthorizeView
                    Policy="@(PermissionClaim.PolicyPrefix + Permissions.AccountingView)"
                    Context="accounting">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="accounts">Accounts</NavLink>
                    </div>
                </AuthorizeView>

                <AuthorizeView Policy="@(PermissionClaim.PolicyPrefix + Permissions.ReportsView)"
                               Context="reports">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="reports">Where things stand</NavLink>
                    </div>
                </AuthorizeView>

                @*
                    The page about yourself, above the three self-service links and
                    behind no permission but being signed in. Requiring employees.view
                    would mean an engineer could not see their own phone number.
                *@
                <AuthorizeView Context="signedIn">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="my-profile">My profile</NavLink>
                    </div>
                </AuthorizeView>

                <AuthorizeView Policy="@(PermissionClaim.PolicyPrefix + Permissions.TimeLogOwn)"
                               Context="myTime">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="time">My time</NavLink>
                    </div>
                </AuthorizeView>

                <AuthorizeView Policy="@(PermissionClaim.PolicyPrefix + Permissions.LeaveAsk)"
                               Context="myLeave">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="leave">My leave</NavLink>
                    </div>
                </AuthorizeView>

                <AuthorizeView Policy="@(PermissionClaim.PolicyPrefix + Permissions.ExpensesClaim)"
                               Context="myExpenses">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="expenses">My expenses</NavLink>
                    </div>
                </AuthorizeView>

                <AuthorizeView Policy="@(PermissionClaim.PolicyPrefix + Permissions.TimeApprove)"
                               Context="timesheets">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="time/approvals">Timesheets</NavLink>
                    </div>
                </AuthorizeView>

                <AuthorizeView Policy="@(PermissionClaim.PolicyPrefix + Permissions.LeaveApprove)"
                               Context="leaveDecisions">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="leave/decisions">Leave</NavLink>
                    </div>
                </AuthorizeView>

                <AuthorizeView Policy="@(PermissionClaim.PolicyPrefix + Permissions.ExpensesViewAll)"
                               Context="claims">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="expenses/claims">Expense claims</NavLink>
                    </div>
                </AuthorizeView>

                <AuthorizeView Policy="@(PermissionClaim.PolicyPrefix + Permissions.ClientsView)"
                               Context="clients">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="clients">Clients</NavLink>
                    </div>

                    @*
                        Above Clients would be truer to the order things happen in, but it is
                        below because the client list is opened many times a day and the
                        pipeline once or twice — and a sidebar is ordered by how often
                        somebody reaches for something, not by chronology.
                    *@
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="pipeline">Pipeline</NavLink>
                    </div>
                </AuthorizeView>

                <AuthorizeView Policy="@(PermissionClaim.PolicyPrefix + Permissions.InvoicesView)"
                               Context="invoices">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="invoices">Invoices</NavLink>
                    </div>
                </AuthorizeView>

                @* Each link is behind the permission the page itself checks,
                   so nobody is shown a door that will refuse them. *@
                <AuthorizeView Policy="@(PermissionClaim.PolicyPrefix + Permissions.EmployeesView)"
                               Context="people">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="people">People</NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="org-chart">Organisation</NavLink>
                    </div>
                </AuthorizeView>

                <AuthorizeView Policy="@(PermissionClaim.PolicyPrefix + Permissions.DepartmentsView)"
                               Context="departments">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="departments">Departments</NavLink>
                    </div>
                </AuthorizeView>

                <AuthorizeView Policy="@(PermissionClaim.PolicyPrefix + Permissions.AuditView)"
                               Context="audit">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="audit">Trail</NavLink>
                    </div>
                </AuthorizeView>

                <AuthorizeView Policy="@(PermissionClaim.PolicyPrefix + Permissions.SettingsManage)"
                               Context="settings">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="settings">Settings</NavLink>
                    </div>
                </AuthorizeView>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="account">
                        <span class="bi bi-person-badge-nav-menu" aria-hidden="true"></span> Your account
                    </NavLink>
                </div>

                <div class="nav-item px-3 nav-who">
                    @(context.User.FindFirst("display_name")?.Value ?? context.User.Identity?.Name)
                </div>

                @*
                    A form, not a link. A sign-out reachable by GET is a URL,
                    and a URL is something another page can load in an <img> to
                    sign a colleague out from across the internet.
                *@
                <div class="nav-item px-3">
                    <form method="post" action="/sign-out">
                        <AntiforgeryToken />
                        <input type="hidden" name="returnUrl" value="/sign-in" />
                        <button type="submit" class="nav-link nav-signout">Sign out</button>
                    </form>
                </div>
            </Authorized>

            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="sign-in">Sign in</NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    /// <summary>How many incidents are open right now.</summary>
    /// <remarks>
    /// Read once per render of the navigation, which is once per page. It is a count over an
    /// index on the status column — see the index on incidents — and it is the cheapest query
    /// in the application.
    /// </remarks>
    private int Happening { get; set; }

    /// <summary>
    /// Counted in a scope of its own, which is not an optimisation.
    /// </summary>
    /// <remarks>
    /// <b>The navigation cannot share the page's database context.</b> Blazor initialises
    /// components concurrently, so this ran at the same moment as whatever the page was reading,
    /// on the same scoped <c>AppDbContext</c> — and a DbContext refuses a second operation while
    /// one is in flight. The result was an intermittent error screen on whichever page happened
    /// to lose the race, which is the worst kind: it worked the first three times it was tried.
    ///
    /// Everything else in this application reads the database from a page, and a page is one
    /// component with one unit of work. The layout is the exception, because it renders beside
    /// every page rather than instead of one, so it gets its own scope and disposes it.
    /// </remarks>
    /// <summary>How many notices this reader has not read.</summary>
    private int Unread { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? Authentication { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await using var scope = Scopes.CreateAsyncScope();

        Happening = await scope.ServiceProvider
            .GetRequiredService<JiranisokoTech.Infrastructure.Incidents.IncidentQueries>()
            .OpenAsync();

        /*
         * In the same scope, and after the count above rather than beside it. Both read the
         * database, and the layout's scope is a single DbContext like any other — two awaits in
         * parallel here would reproduce exactly the race that put the incidents count in its own
         * scope in the first place.
         */
        if (Authentication is null)
        {
            return;
        }

        var user = (await Authentication).User;

        if (!Guid.TryParse(
            user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value,
            out var account))
        {
            return;
        }

        var people = scope.ServiceProvider
            .GetRequiredService<JiranisokoTech.Infrastructure.People.PeopleQueries>();

        if (await people.EmployeeForAccountAsync(account) is { } me)
        {
            Unread = await scope.ServiceProvider
                .GetRequiredService<JiranisokoTech.Application.Notices.NoticeService>()
                .UnreadForAsync(me);
        }
    }
}
