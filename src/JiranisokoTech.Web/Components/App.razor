@using JiranisokoTech.Web.Identity
﻿<!DOCTYPE html>
@*
    The theme is stamped here, on the server, before the first byte is written.

    The usual approach — a script that reads storage and sets this after load — means every
    page arrives in the wrong colour and repaints a moment later. A cookie is read before
    the response starts, so it never does.
*@
<html lang="en" data-theme="@Theme">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["JiranisokoTech.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    @*
        No global render mode, deliberately.

        Signing in sets a cookie, and a cookie can only be written while the
        response is still being composed — which means the page must be
        statically rendered. With interactivity applied here it would apply to
        every page including those, and the sign-in form would render fine and
        then fail to do the one thing it exists for.

        So interactivity is opted into per component with @@rendermode, and
        anything that touches authentication stays static.
    *@
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["nav.js"]"></script>
    @*
        The palette and the shortcuts. An external file, because the content security policy
        refuses inline script — deliberately, and loosening it has already cost this
        application one outage.
    *@
    <script src="palette.js"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext? Request { get; set; }

    /// <summary>
    /// What this reader has chosen, or nothing.
    /// </summary>
    /// <remarks>
    /// Nothing is the default, and it means "whatever this device prefers" — which the media
    /// query in the stylesheet answers. Only the two known words are ever emitted, because
    /// this value lands in an attribute and an unvalidated one would be an injection.
    /// </remarks>
    private string? Theme => Request.ChosenTheme();
}
